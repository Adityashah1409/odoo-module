<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_powerbi" model="res.groups.privilege">
        <field name="name">Power BI</field>
        <field name="sequence">70</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_powerbi_user" model="res.groups">
        <field name="name">Report viewer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_powerbi"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_powerbi_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_powerbi"/>
        <field name="implied_ids" eval="[Command.link(ref('group_powerbi_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

</odoo>
