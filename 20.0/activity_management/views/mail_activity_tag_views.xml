<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_activity_tag_view_list" model="ir.ui.view">
        <field name="name">mail.activity.tag.list</field>
        <field name="model">mail.activity.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_mail_activity_tag" model="ir.actions.act_window">
        <field name="name">Activity Tags</field>
        <field name="res_model">mail.activity.tag</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
