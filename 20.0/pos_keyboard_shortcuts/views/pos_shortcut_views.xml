<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_shortcut_list" model="ir.ui.view">
        <field name="name">pos.shortcut.list</field>
        <field name="model">pos.shortcut</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="config_id" column_invisible="context.get('default_config_id')"/>
                <field name="screen"/>
                <field name="action"/>
                <field name="allowed_payment_method_ids" column_invisible="1"/>
                <field name="payment_method_id" invisible="action != 'payment_method'"
                       required="action == 'payment_method'" options="{'no_create': True}"/>
                <field name="key" placeholder="shift+p"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_pos_shortcut_search" model="ir.ui.view">
        <field name="name">pos.shortcut.search</field>
        <field name="model">pos.shortcut</field>
        <field name="arch" type="xml">
            <search>
                <field name="key"/>
                <field name="action"/>
                <field name="config_id"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_config" string="Point of Sale" context="{'group_by': 'config_id'}"/>
                    <filter name="group_screen" string="Screen" context="{'group_by': 'screen'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pos_shortcut" model="ir.actions.act_window">
        <field name="name">Keyboard Shortcuts</field>
        <field name="res_model">pos.shortcut</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_config': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No shortcut yet</p>
            <p>Enable keyboard shortcuts in the Point of Sale settings to load the default set, then adapt it.</p>
        </field>
    </record>

    <menuitem id="menu_pos_shortcut" name="Keyboard Shortcuts" parent="point_of_sale.menu_point_config_product"
              action="action_pos_shortcut" sequence="60" groups="point_of_sale.group_pos_manager"/>
</odoo>
