<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="event_seat_plan_view_list" model="ir.ui.view">
        <field name="name">event.seat.plan.list</field>
        <field name="model">event.seat.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="seat_rows"/>
                <field name="seat_columns"/>
                <field name="seat_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="website_id" groups="website.group_multi_website"/>
            </list>
        </field>
    </record>
    <record id="event_seat_plan_view_form" model="ir.ui.view">
        <field name="name">event.seat.plan.form</field>
        <field name="model">event.seat.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Main hall - 12 rows"/></h1></div>
                    <group>
                        <group string="Layout">
                            <field name="seat_rows"/>
                            <field name="seat_columns"/>
                            <field name="seat_row_label" widget="radio" options="{'horizontal': true}"/>
                            <field name="seat_aisle_rows" placeholder="e.g. 5"/>
                            <field name="seat_aisle_columns" placeholder="e.g. 4, 12"/>
                            <field name="seat_blocked" placeholder="e.g. A1, A16, M"/>
                            <field name="seat_stage_label"/>
                        </group>
                        <group string="Availability">
                            <field name="seat_count"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="website_id" groups="website.group_multi_website"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Preview" name="preview">
                            <field name="seat_map_preview" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Premium rows" name="surcharges">
                            <field name="surcharge_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="rows" placeholder="e.g. A-C"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_event_seat_plan" model="ir.actions.act_window">
        <field name="name">Seating Plans</field>
        <field name="res_model">event.seat.plan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Save the layout of your venues</p>
            <p>Rows, seats per row, aisles, blocked seats and premium rows; apply a plan to any ticket type.</p>
        </field>
    </record>
</odoo>
