<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="event_seat_switch_view_form" model="ir.ui.view">
        <field name="name">event.seat.switch.form</field>
        <field name="model">event.seat.switch</field>
        <field name="arch" type="xml">
            <form>
                <field name="registration_id" invisible="1"/>
                <field name="event_id" invisible="1"/>
                <field name="ticket_id" invisible="1"/>
                <group>
                    <field name="current_seat_id"/>
                    <field name="same_section"/>
                    <field name="seat_id" options="{'no_create': True}"/>
                    <field name="price_difference" invisible="not seat_id"/>
                </group>
                <footer>
                    <button name="action_switch" type="object" string="Switch" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
