<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_refresh_rules" model="ir.cron">
        <field name="name">Access Management: apply rule schedules</field>
        <field name="model_id" ref="model_access_rule"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="ir_cron_cleanup_export_logs" model="ir.cron">
        <field name="name">Access Management: clean old export logs</field>
        <field name="model_id" ref="model_access_export_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
