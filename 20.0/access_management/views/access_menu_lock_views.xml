<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="access_menu_lock_view_form" model="ir.ui.view">
        <field name="name">access.menu.lock.form</field>
        <field name="model">access.menu.lock</field>
        <field name="arch" type="xml">
            <form string="PIN-protected menu">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="menu_id"/>
                        <h1><field name="menu_id" options="{'no_create': True}" placeholder="Choose a menu"/></h1>
                    </div>
                    <group>
                        <group string="Code">
                            <field name="pin_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="has_code" invisible="1"/>
                            <field name="code" password="True" required="not has_code"
                                   placeholder="Type a new code"/>
                            <div colspan="2" class="text-muted small" invisible="not has_code">
                                A code is set. Type a new one only to change it.
                            </div>
                            <field name="unlock_minutes"/>
                        </group>
                        <group string="Protection">
                            <field name="max_attempts"/>
                            <field name="lockout_minutes"/>
                            <field name="alert_emails" placeholder="security@example.com"/>
                            <field name="failed_count"/>
                        </group>
                    </group>
                    <group string="Ask the code to">
                        <field name="user_ids" widget="many2many_tags" options="{'no_create': True}"
                               placeholder="Everybody"/>
                        <field name="group_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <notebook>
                        <page string="Attempts" name="attempts">
                            <field name="attempt_ids" readonly="1">
                                <list decoration-danger="not success" decoration-success="success">
                                    <field name="create_date" string="Date"/>
                                    <field name="user_id"/>
                                    <field name="success"/>
                                    <field name="ip_address"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="access_menu_lock_view_list" model="ir.ui.view">
        <field name="name">access.menu.lock.list</field>
        <field name="model">access.menu.lock</field>
        <field name="arch" type="xml">
            <list string="PIN-protected menus">
                <field name="menu_id"/>
                <field name="pin_type"/>
                <field name="user_ids" widget="many2many_tags" optional="show"/>
                <field name="group_ids" widget="many2many_tags" optional="show"/>
                <field name="max_attempts"/>
                <field name="lockout_minutes"/>
                <field name="failed_count"/>
            </list>
        </field>
    </record>

    <record id="action_access_menu_lock" model="ir.actions.act_window">
        <field name="name">PIN-protected Menus</field>
        <field name="res_model">access.menu.lock</field>
        <field name="path">menu-locks</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Protect a menu with a PIN</p>
            <p>Users must type the code before the menu opens, even from a bookmarked URL.</p>
        </field>
    </record>

    <record id="access_lock_attempt_view_list" model="ir.ui.view">
        <field name="name">access.lock.attempt.list</field>
        <field name="model">access.lock.attempt</field>
        <field name="arch" type="xml">
            <list string="PIN attempts" create="0" edit="0" decoration-danger="not success">
                <field name="create_date" string="Date"/>
                <field name="menu_id"/>
                <field name="user_id"/>
                <field name="success"/>
                <field name="ip_address"/>
            </list>
        </field>
    </record>

    <record id="access_lock_attempt_view_search" model="ir.ui.view">
        <field name="name">access.lock.attempt.search</field>
        <field name="model">access.lock.attempt</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="lock_id"/>
                <filter name="failed" string="Failed" domain="[('success', '=', False)]"/>
                <filter name="succeeded" string="Succeeded" domain="[('success', '=', True)]"/>
                <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                <filter name="group_lock" string="Menu" context="{'group_by': 'lock_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_access_lock_attempt" model="ir.actions.act_window">
        <field name="name">PIN Attempts</field>
        <field name="res_model">access.lock.attempt</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
