<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="access_export_log_view_list" model="ir.ui.view">
        <field name="name">access.export.log.list</field>
        <field name="model">access.export.log</field>
        <field name="arch" type="xml">
            <list string="Export log" create="0" edit="0" decoration-danger="alert">
                <field name="create_date" string="Date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="model_name"/>
                <field name="model" optional="hide"/>
                <field name="record_count" sum="Total"/>
                <field name="field_count" optional="show"/>
                <field name="field_names" optional="hide"/>
                <field name="ip_address" optional="show"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <field name="alert" widget="boolean" optional="show"/>
            </list>
        </field>
    </record>

    <record id="access_export_log_view_form" model="ir.ui.view">
        <field name="name">access.export.log.form</field>
        <field name="model">access.export.log</field>
        <field name="arch" type="xml">
            <form string="Export" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="create_date" string="Date"/>
                            <field name="ip_address"/>
                        </group>
                        <group>
                            <field name="model_name"/>
                            <field name="model"/>
                            <field name="record_count"/>
                            <field name="alert"/>
                        </group>
                    </group>
                    <group string="Columns">
                        <field name="field_names" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="access_export_log_view_search" model="ir.ui.view">
        <field name="name">access.export.log.search</field>
        <field name="model">access.export.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="model_name"/>
                <field name="model"/>
                <filter name="alerts" string="Leak alerts" domain="[('alert', '=', True)]"/>
                <filter name="today" string="Today" domain="[('create_date', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="create_date" string="Date" date="create_date"/>
                <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                <filter name="group_model" string="Document" context="{'group_by': 'model_name'}"/>
            </search>
        </field>
    </record>

    <record id="access_export_log_view_pivot" model="ir.ui.view">
        <field name="name">access.export.log.pivot</field>
        <field name="model">access.export.log</field>
        <field name="arch" type="xml">
            <pivot string="Exports">
                <field name="user_id" type="row"/>
                <field name="model_name" type="col"/>
                <field name="record_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_access_export_log" model="ir.actions.act_window">
        <field name="name">Export Log</field>
        <field name="res_model">access.export.log</field>
        <field name="path">export-log</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No export yet</p>
            <p>Every export from a list is logged here: who, what, how many records and which columns.</p>
        </field>
    </record>
</odoo>
