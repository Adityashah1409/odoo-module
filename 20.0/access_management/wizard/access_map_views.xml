<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="access_map_view_form" model="ir.ui.view">
        <field name="name">access.map.form</field>
        <field name="model">access.map</field>
        <field name="arch" type="xml">
            <form string="Access map">
                <header>
                    <button name="action_compute" type="object" string="Compute" class="btn-primary"/>
                    <button name="action_open_lines" type="object" string="Open as list" invisible="not line_ids"/>
                    <button name="action_download_xlsx" type="object" string="Download Excel" icon="download"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="user_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="hide_technical"/>
                            <field name="line_count" string="Models" invisible="not line_ids"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="1">
                        <list limit="200">
                            <field name="area"/>
                            <field name="model_name"/>
                            <field name="model" optional="show"/>
                            <field name="perm_read" widget="badge" decoration-success="perm_read == 'full'"
                                   decoration-warning="perm_read == 'partial'" decoration-danger="perm_read == 'none'"/>
                            <field name="perm_write" widget="badge" decoration-success="perm_write == 'full'"
                                   decoration-warning="perm_write == 'partial'" decoration-danger="perm_write == 'none'"/>
                            <field name="perm_create" widget="badge" decoration-success="perm_create == 'full'"
                                   decoration-warning="perm_create == 'partial'" decoration-danger="perm_create == 'none'"/>
                            <field name="perm_unlink" widget="badge" decoration-success="perm_unlink == 'full'"
                                   decoration-warning="perm_unlink == 'partial'" decoration-danger="perm_unlink == 'none'"/>
                            <field name="managed" widget="boolean"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="access_map_line_view_list" model="ir.ui.view">
        <field name="name">access.map.line.list</field>
        <field name="model">access.map.line</field>
        <field name="arch" type="xml">
            <list string="Access map" create="0" edit="0" delete="0">
                <field name="area"/>
                <field name="model_name"/>
                <field name="model"/>
                <field name="perm_read" widget="badge" decoration-success="perm_read == 'full'"
                       decoration-warning="perm_read == 'partial'" decoration-danger="perm_read == 'none'"/>
                <field name="perm_write" widget="badge" decoration-success="perm_write == 'full'"
                       decoration-warning="perm_write == 'partial'" decoration-danger="perm_write == 'none'"/>
                <field name="perm_create" widget="badge" decoration-success="perm_create == 'full'"
                       decoration-warning="perm_create == 'partial'" decoration-danger="perm_create == 'none'"/>
                <field name="perm_unlink" widget="badge" decoration-success="perm_unlink == 'full'"
                       decoration-warning="perm_unlink == 'partial'" decoration-danger="perm_unlink == 'none'"/>
                <field name="managed" widget="boolean"/>
            </list>
        </field>
    </record>

    <record id="access_map_line_view_search" model="ir.ui.view">
        <field name="name">access.map.line.search</field>
        <field name="model">access.map.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="model_name"/>
                <field name="model"/>
                <field name="area"/>
                <filter name="writable" string="Can write" domain="[('perm_write', '!=', 'none')]"/>
                <filter name="readonly" string="Read only" domain="[('perm_read', '!=', 'none'), ('perm_write', '=', 'none')]"/>
                <filter name="limited" string="Limited by rules" domain="['|', '|', '|', ('perm_read', '=', 'partial'), ('perm_write', '=', 'partial'), ('perm_create', '=', 'partial'), ('perm_unlink', '=', 'partial')]"/>
                <filter name="managed" string="Access Management rules" domain="[('managed', '=', True)]"/>
                <filter name="group_area" string="Application" context="{'group_by': 'area'}"/>
            </search>
        </field>
    </record>

    <record id="action_access_map" model="ir.actions.act_window">
        <field name="name">Access Map</field>
        <field name="res_model">access.map</field>
        <field name="path">access-map</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
