<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_whapi" model="ir.ui.view">
        <field name="name">res.partner.form.whapi</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_whapi_open_chat" type="object" class="oe_stat_button" icon="oi_whatsapp"
                        groups="whatsapp_whapi.group_whapi_user" invisible="not phone and not whapi_message_count">
                    <field name="whapi_message_count" string="WhatsApp" widget="statinfo"/>
                </button>
            </div>
        </field>
    </record>

    <record id="action_server_partner_whapi_send" model="ir.actions.server">
        <field name="name">Send by WhatsApp</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">form,list</field>
        <field name="group_ids" eval="[Command.link(ref('whatsapp_whapi.group_whapi_user'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_whapi_send()</field>
    </record>
</odoo>
