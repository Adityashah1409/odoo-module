<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_login_as" model="res.groups.privilege">
        <field name="name">Login as other user</field>
        <field name="category_id" ref="base.module_category_administration"/>
        <field name="sequence">90</field>
    </record>

    <record id="group_login_as" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_login_as"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Can open a session as another user (support / troubleshooting). Every session is logged.</field>
    </record>

</odoo>
