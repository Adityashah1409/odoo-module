<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="login_as_user.Systray">
        <div class="o_login_as_systray d-flex align-items-center h-100">
            <t t-if="this.info.origin">
                <div class="o_login_as_pill d-flex align-items-center gap-2 px-2 py-1 rounded-pill me-1">
                    <i class="oi" data-icon="oi_user-secret" title="Logged in as another user"/>
                    <span class="d-none d-md-inline">As <b t-out="this.userName"/></span>
                    <span t-if="this.state.remaining" class="o_login_as_timer rounded-pill px-2 bg-white text-danger fw-bold"
                          title="Time left before switching back" t-out="this.remainingLabel"/>
                    <button t-if="this.info.can" class="btn btn-sm btn-link text-white p-0 o_login_as_other"
                            title="Log in as another user" t-on-click="this.openSwitch">
                        <i class="oi" data-icon="swap_horiz"/>
                    </button>
                    <button class="btn btn-sm btn-light py-0 o_login_as_back" t-on-click="this.back"
                            t-att-disabled="this.state.busy">
                        <i class="oi me-1" data-icon="undo"/>Back to <t t-out="this.info.origin.name"/>
                    </button>
                </div>
            </t>
            <t t-else="">
                <button class="o_nav_entry btn o_login_as_open" title="Log in as another user"
                        t-on-click="this.openSwitch">
                    <i class="oi oi-lg" data-icon="oi_user-secret"/>
                </button>
            </t>
        </div>
    </t>
</templates>
