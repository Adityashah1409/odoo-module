<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_login_as" model="ir.ui.view">
        <field name="name">res.users.form.login_as</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_login_as" type="object" string="Log in as" icon="oi_user-secret"
                        class="btn-secondary" groups="login_as_user.group_login_as" invisible="not id or not active"/>
            </header>
            <div name="button_box" position="inside">
                <button name="action_view_login_as_logs" type="object" class="oe_stat_button" icon="oi_user-secret"
                        groups="login_as_user.group_login_as" invisible="not login_as_count">
                    <field name="login_as_count" string="Login As" widget="statinfo"/>
                </button>
            </div>
        </field>
    </record>

    <record id="action_server_login_as" model="ir.actions.server">
        <field name="name">Log in as</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="binding_model_id" ref="base.model_res_users"/>
        <field name="binding_view_types">form,list</field>
        <field name="group_ids" eval="[Command.link(ref('login_as_user.group_login_as'))]"/>
        <field name="state">code</field>
        <field name="code">action = record.action_login_as() if len(records) == 1 else {'type': 'ir.actions.client', 'tag': 'login_as_user.switch'}</field>
    </record>
</odoo>
