<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="support_sla_view_list" model="ir.ui.view">
        <field name="name">support.sla.list</field>
        <field name="model">support.sla</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="team_id"/>
                <field name="priority" widget="priority"/>
                <field name="type_ids" widget="many2many_tags"/>
                <field name="stage_id"/>
                <field name="time" widget="float_time"/>
                <field name="status_count"/>
                <field name="failed_rate" widget="percentage"/>
            </list>
        </field>
    </record>
    <record id="support_sla_view_form" model="ir.ui.view">
        <field name="name">support.sla.form</field>
        <field name="model">support.sla</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_status" type="object" class="oe_stat_button" icon="bar_chart">
                            <field name="status_count" widget="statinfo" string="Tickets"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Urgent: first answer in 2 hours"/></h1></div>
                    <group>
                        <group string="Applies to">
                            <field name="team_id"/>
                            <field name="priority" widget="priority"/>
                            <field name="type_ids" widget="many2many_tags"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="partner_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Target">
                            <field name="stage_id"/>
                            <field name="time" widget="float_time"/>
                            <div colspan="2" class="text-muted small">Counted from the ticket creation, on the working hours
                                of the team. Reaching the stage (or a later one, or closing the ticket) stops the clock.</div>
                        </group>
                    </group>
                    <field name="description" placeholder="Contract reference, notes..."/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_support_sla" model="ir.actions.act_window">
        <field name="name">SLA Policies</field>
        <field name="res_model">support.sla</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <!-- SLA status analysis -->
    <record id="support_ticket_sla_view_list" model="ir.ui.view">
        <field name="name">support.ticket.sla.list</field>
        <field name="model">support.ticket.sla</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="status == 'failed'" decoration-success="status == 'reached'">
                <field name="ticket_id"/>
                <field name="sla_id"/>
                <field name="team_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="deadline"/>
                <field name="reached_datetime"/>
                <field name="exceeded_hours" widget="float_time"/>
                <field name="status" widget="badge" decoration-danger="status == 'failed'"
                       decoration-success="status == 'reached'" decoration-info="status == 'ongoing'"/>
            </list>
        </field>
    </record>
    <record id="support_ticket_sla_view_search" model="ir.ui.view">
        <field name="name">support.ticket.sla.search</field>
        <field name="model">support.ticket.sla</field>
        <field name="arch" type="xml">
            <search>
                <field name="ticket_id"/>
                <field name="sla_id"/>
                <field name="team_id"/>
                <field name="user_id"/>
                <filter name="ongoing" string="Ongoing" domain="[('status', '=', 'ongoing')]"/>
                <filter name="reached" string="Reached" domain="[('status', '=', 'reached')]"/>
                <filter name="failed" string="Failed" domain="[('status', '=', 'failed')]"/>
                <filter name="deadline" string="Deadline" date="deadline"/>
                <group>
                    <filter name="group_sla" string="Policy" context="{'group_by': 'sla_id'}"/>
                    <filter name="group_team" string="Team" context="{'group_by': 'team_id'}"/>
                    <filter name="group_user" string="Assigned to" context="{'group_by': 'user_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="support_ticket_sla_view_pivot" model="ir.ui.view">
        <field name="name">support.ticket.sla.pivot</field>
        <field name="model">support.ticket.sla</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="sla_id" type="row"/>
                <field name="status" type="col"/>
            </pivot>
        </field>
    </record>
    <record id="support_ticket_sla_view_graph" model="ir.ui.view">
        <field name="name">support.ticket.sla.graph</field>
        <field name="model">support.ticket.sla</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="1">
                <field name="team_id"/>
                <field name="status"/>
            </graph>
        </field>
    </record>
    <record id="action_support_sla_report" model="ir.actions.act_window">
        <field name="name">SLA Analysis</field>
        <field name="res_model">support.ticket.sla</field>
        <field name="view_mode">pivot,graph,list</field>
    </record>
</odoo>
