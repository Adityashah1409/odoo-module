<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_auto_discount" model="ir.ui.view">
        <field name="name">res.config.settings.form.pos.auto.discount</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_pricing_section']" position="inside">
                <setting id="pos_auto_discount" string="Automatic discounts"
                         help="Apply discount rules by product, category, quantity, dates and happy hours.">
                    <field name="pos_auto_discount_enabled"/>
                    <div class="mt-2" invisible="not pos_auto_discount_enabled">
                        <div>
                            <field name="pos_auto_discount_badge" class="w-auto me-2"/>
                            <label for="pos_auto_discount_badge" string="Show discount badges on product cards"/>
                        </div>
                        <button name="action_pos_auto_discounts" type="object" string="Discount rules"
                                class="btn-link" icon="east"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
