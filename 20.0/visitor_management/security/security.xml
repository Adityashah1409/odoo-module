<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_visitor" model="res.groups.privilege">
        <field name="name">Visitors</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>
    <record id="group_visitor_user" model="res.groups">
        <field name="name">Receptionist</field>
        <field name="privilege_id" ref="privilege_visitor"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Registers visitors, checks them in and out, prints passes.</field>
    </record>
    <record id="group_visitor_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_visitor"/>
        <field name="implied_ids" eval="[Command.link(ref('group_visitor_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Also configures types, categories, destinations and the kiosk.</field>
    </record>

</odoo>
