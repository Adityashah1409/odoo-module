<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_visitor_visit" model="ir.sequence">
        <field name="name">Visit</field>
        <field name="code">visitor.visit</field>
        <field name="prefix">VIS/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="cron_visitor_auto_check_out" model="ir.cron">
        <field name="name">Visitors: automatic check-out</field>
        <field name="model_id" ref="model_visitor_visit"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_check_out()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>

    <data noupdate="1">
        <record id="visit_type_meeting" model="visitor.visit.type">
            <field name="name">Meeting</field>
            <field name="sequence">1</field>
            <field name="color">4</field>
            <field name="expected_hours">2</field>
        </record>
        <record id="visit_type_interview" model="visitor.visit.type">
            <field name="name">Job interview</field>
            <field name="sequence">2</field>
            <field name="color">10</field>
            <field name="expected_hours">1.5</field>
        </record>
        <record id="visit_type_delivery" model="visitor.visit.type">
            <field name="name">Delivery / pick-up</field>
            <field name="sequence">3</field>
            <field name="color">2</field>
            <field name="expected_hours">0.5</field>
        </record>
        <record id="visit_type_contractor" model="visitor.visit.type">
            <field name="name">Contractor / maintenance</field>
            <field name="sequence">4</field>
            <field name="color">9</field>
            <field name="expected_hours">8</field>
            <field name="kiosk" eval="False"/>
        </record>

        <record id="visit_category_regular" model="visitor.visit.category">
            <field name="name">Regular</field>
            <field name="sequence">1</field>
            <field name="color">0</field>
        </record>
        <record id="visit_category_vip" model="visitor.visit.category">
            <field name="name">VIP</field>
            <field name="sequence">2</field>
            <field name="color">3</field>
        </record>
        <record id="visit_category_escorted" model="visitor.visit.category">
            <field name="name">Escorted</field>
            <field name="sequence">3</field>
            <field name="color">1</field>
            <field name="escort" eval="True"/>
        </record>
    </data>
</odoo>
