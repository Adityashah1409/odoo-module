<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="visitor_visit_view_search" model="ir.ui.view">
        <field name="name">visitor.visit.search</field>
        <field name="model">visitor.visit</field>
        <field name="arch" type="xml">
            <search string="Visits">
                <field name="visitor_name" string="Visitor" filter_domain="['|', '|', ('visitor_name', 'ilike', self), ('visitor_company', 'ilike', self), ('name', 'ilike', self)]"/>
                <field name="pass_code"/>
                <field name="host_id"/>
                <field name="department_id"/>
                <field name="visit_type_id"/>
                <field name="partner_id"/>
                <filter name="today" string="Today"
                        domain="['|', ('state', '=', 'on_site'), '|', '&amp;', ('planned_date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)).to_utc().strftime('%Y-%m-%d %H:%M:%S')), ('planned_date', '&lt;', datetime.datetime.combine(context_today() + relativedelta(days=1), datetime.time(0,0,0)).to_utc().strftime('%Y-%m-%d %H:%M:%S')), ('check_in', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)).to_utc().strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <separator/>
                <filter name="expected" string="Expected" domain="[('state', '=', 'planned')]"/>
                <filter name="on_site" string="On site" domain="[('state', '=', 'on_site')]"/>
                <filter name="done" string="Checked out" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="my_visitors" string="My visitors" domain="[('host_id.user_id', '=', uid)]"/>
                <filter name="kiosk" string="From the kiosk" domain="[('source', '=', 'kiosk')]"/>
                <filter name="auto" string="Checked out automatically" domain="[('auto_checked_out', '=', True)]"/>
                <separator/>
                <filter name="check_in_date" string="Check-in" date="check_in"/>
                <filter name="planned" string="Expected on" date="planned_date"/>
                <group>
                    <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="by_host" string="Host" context="{'group_by': 'host_id'}"/>
                    <filter name="by_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="by_type" string="Visit type" context="{'group_by': 'visit_type_id'}"/>
                    <filter name="by_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="by_day" string="Check-in day" context="{'group_by': 'check_in:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="visitor_visit_view_kanban" model="ir.ui.view">
        <field name="name">visitor.visit.kanban</field>
        <field name="model">visitor.visit</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" group_create="false" group_delete="false"
                    group_edit="false" records_draggable="false" sample="1" highlight_color="color">
                <field name="state"/>
                <field name="color"/>
                <field name="overstay"/>
                <field name="escort"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start">
                            <field name="visitor_name" class="fw-bold fs-5"/>
                            <span class="badge text-bg-light font-monospace"><field name="pass_code"/></span>
                        </div>
                        <field name="visitor_company" class="text-muted"/>
                        <field name="purpose" class="small"/>
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            <field name="visit_type_id" widget="badge"/>
                            <field name="category_id" widget="badge"/>
                            <span t-if="record.overstay.raw_value" class="badge text-bg-warning">Longer than usual</span>
                            <span t-if="record.escort.raw_value" class="badge text-bg-danger">Escort</span>
                        </div>
                        <footer class="mt-2">
                            <div class="d-flex align-items-center gap-1 small text-muted">
                                <t t-if="record.state.raw_value == 'planned'">
                                    <i class="oi oi-filled" data-icon="calendar_today" title="Expected on"/> <field name="planned_date"/>
                                </t>
                                <t t-elif="record.state.raw_value == 'on_site'">
                                    <i class="oi" data-icon="login" title="Check-in"/> <field name="check_in"/>
                                </t>
                                <t t-elif="record.state.raw_value == 'done'">
                                    <i class="oi" data-icon="schedule" title="Time on site"/> <field name="duration" widget="float_time"/>
                                </t>
                            </div>
                            <div class="ms-auto d-flex align-items-center gap-1">
                                <button t-if="record.state.raw_value == 'planned'" name="action_check_in" type="object"
                                        class="btn btn-sm btn-primary">Check in</button>
                                <button t-if="record.state.raw_value == 'on_site'" name="action_check_out" type="object"
                                        class="btn btn-sm btn-secondary">Check out</button>
                                <field name="host_id" widget="many2one_avatar_employee"/>
                            </div>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="visitor_visit_view_list" model="ir.ui.view">
        <field name="name">visitor.visit.list</field>
        <field name="model">visitor.visit</field>
        <field name="arch" type="xml">
            <list string="Visits" sample="1" decoration-muted="state == 'cancel'" decoration-info="state == 'planned'"
                  decoration-success="state == 'on_site'">
                <field name="name" optional="show"/>
                <field name="visitor_name"/>
                <field name="visitor_company" string="Company" optional="show"/>
                <field name="host_id" widget="many2one_avatar_employee"/>
                <field name="department_id" optional="hide"/>
                <field name="visit_type_id" optional="show"/>
                <field name="category_id" optional="hide"/>
                <field name="destination_id" optional="hide"/>
                <field name="planned_date" optional="show"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="duration" widget="float_time" sum="Total" optional="show"/>
                <field name="guests" sum="Total" optional="hide"/>
                <field name="pass_code" optional="hide"/>
                <field name="source" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'planned'"
                       decoration-success="state == 'on_site'" decoration-muted="state in ('done', 'cancel')"/>
                <button name="action_check_in" type="object" string="Check in" icon="login"
                        invisible="state != 'planned'" class="btn-link"/>
                <button name="action_check_out" type="object" string="Check out" icon="logout"
                        invisible="state != 'on_site'" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="visitor_visit_view_form" model="ir.ui.view">
        <field name="name">visitor.visit.form</field>
        <field name="model">visitor.visit</field>
        <field name="arch" type="xml">
            <form string="Visit">
                <header>
                    <button name="action_check_in" type="object" string="Check in" class="btn-primary"
                            invisible="state != 'planned'" data-hotkey="i"/>
                    <button name="action_check_out" type="object" string="Check out" class="btn-primary"
                            invisible="state != 'on_site'" data-hotkey="o"/>
                    <button name="action_send_invitation" type="object" string="Send invitation"
                            invisible="state != 'planned' or not email"/>
                    <button name="action_print_pass" type="object" string="Print pass"
                            invisible="state not in ('planned', 'on_site')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('planned', 'on_site')"/>
                    <button name="action_reset" type="object" string="Reset to expected"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,on_site,done"/>
                </header>
                <div class="alert alert-danger mb-0 rounded-0" role="alert" invisible="not escort or state != 'on_site'">
                    <i class="oi" data-icon="warning" title="Escort"/> This visitor must be escorted at all times.
                </div>
                <div class="alert alert-warning mb-0 rounded-0" role="alert" invisible="not overstay">
                    <i class="oi" data-icon="schedule" title="Overstay"/> On site for longer than usual for this type of visit.
                </div>
                <sheet>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancel'"/>
                    <widget name="web_ribbon" title="Auto check-out" bg_color="text-bg-warning"
                            invisible="not auto_checked_out"/>
                    <div class="oe_title">
                        <div class="text-muted"><field name="name" readonly="1"/></div>
                        <h1><field name="visitor_name" placeholder="Visitor's name"/></h1>
                    </div>
                    <group>
                        <group string="Visitor" name="visitor">
                            <field name="partner_id" placeholder="Existing contact (optional)"/>
                            <field name="visitor_company" string="Company"/>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="guests"/>
                            <field name="vehicle"/>
                        </group>
                        <group string="Visit" name="visit">
                            <field name="host_id" widget="many2one_avatar_employee"/>
                            <field name="department_id"/>
                            <field name="visit_type_id" options="{'no_create': True}"/>
                            <field name="category_id" options="{'no_create': True}"/>
                            <field name="destination_id"/>
                            <field name="purpose"/>
                        </group>
                        <group string="Times" name="times">
                            <field name="planned_date"/>
                            <field name="check_in"/>
                            <field name="check_out"/>
                            <field name="duration" widget="float_time" invisible="not check_out"/>
                        </group>
                        <group string="Pass" name="pass">
                            <field name="pass_code" class="font-monospace fw-bold"/>
                            <field name="source"/>
                            <field name="invitation_sent" invisible="not invitation_sent"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes for the reception (badge number, equipment lent, ...)"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="visitor_visit_view_calendar" model="ir.ui.view">
        <field name="name">visitor.visit.calendar</field>
        <field name="model">visitor.visit</field>
        <field name="arch" type="xml">
            <calendar string="Visits" date_start="planned_date" color="visit_type_id" mode="week" quick_create="0"
                      event_open_popup="1">
                <field name="visitor_name"/>
                <field name="visitor_company"/>
                <field name="host_id" filters="1" avatar_field="avatar_128"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="visitor_visit_view_pivot" model="ir.ui.view">
        <field name="name">visitor.visit.pivot</field>
        <field name="model">visitor.visit</field>
        <field name="arch" type="xml">
            <pivot string="Visits" sample="1">
                <field name="check_in" interval="month" type="col"/>
                <field name="department_id" type="row"/>
                <field name="duration" type="measure" widget="float_time"/>
            </pivot>
        </field>
    </record>

    <record id="visitor_visit_view_graph" model="ir.ui.view">
        <field name="name">visitor.visit.graph</field>
        <field name="model">visitor.visit</field>
        <field name="arch" type="xml">
            <graph string="Visits" type="bar" sample="1">
                <field name="check_in" interval="week"/>
                <field name="visit_type_id"/>
            </graph>
        </field>
    </record>

    <record id="action_visitor_visit" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="res_model">visitor.visit</field>
        <field name="path">visits</field>
        <field name="view_mode">kanban,list,form,calendar,pivot,graph</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register a visitor</p>
            <p>Plan expected visits, check visitors in and out, or let them check in at the kiosk.</p>
        </field>
    </record>

    <record id="action_visitor_visit_analysis" model="ir.actions.act_window">
        <field name="name">Visits Analysis</field>
        <field name="res_model">visitor.visit</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="domain">[('state', 'in', ('on_site', 'done'))]</field>
    </record>

    <record id="action_visitor_open_kiosk" model="ir.actions.server">
        <field name="name">Open kiosk</field>
        <field name="model_id" ref="model_visitor_visit"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_kiosk()</field>
        <field name="group_ids" eval="[Command.link(ref('group_visitor_user'))]"/>
    </record>

    <record id="action_visitor_check_out_selected" model="ir.actions.server">
        <field name="name">Check out</field>
        <field name="model_id" ref="model_visitor_visit"/>
        <field name="binding_model_id" ref="model_visitor_visit"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
        <field name="code">records.filtered(lambda v: v.state == 'on_site').action_check_out()</field>
        <field name="group_ids" eval="[Command.link(ref('group_visitor_user'))]"/>
    </record>
</odoo>
