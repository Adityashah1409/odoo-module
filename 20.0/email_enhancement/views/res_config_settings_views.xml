<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.email.cc</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="emails" position="inside">
                <setting id="mail_cc_bcc_setting" string="Cc, Bcc and Reply-To"
                         help="Proposed in the e-mail composer of every document; editable before sending.">
                    <div class="row mt-2">
                        <label for="mail_default_cc" string="Cc" class="col-lg-3 o_light_label"/>
                        <field name="mail_default_cc" class="col-lg-9" placeholder="e.g. archive@company.com"/>
                    </div>
                    <div class="row">
                        <label for="mail_default_bcc" string="Bcc" class="col-lg-3 o_light_label"/>
                        <field name="mail_default_bcc" class="col-lg-9"/>
                    </div>
                    <div class="row">
                        <label for="mail_default_reply_to" string="Reply-To" class="col-lg-3 o_light_label"/>
                        <field name="mail_default_reply_to" class="col-lg-9"/>
                    </div>
                    <div class="mt-1">
                        <button name="%(email_enhancement.action_mail_cc_rule)d" type="action" icon="east"
                                string="Rules per document and sender" class="btn-link"/>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>
