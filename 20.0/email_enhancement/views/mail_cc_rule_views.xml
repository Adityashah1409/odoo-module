<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_cc_rule_view_list" model="ir.ui.view">
        <field name="name">mail.cc.rule.list</field>
        <field name="model">mail.cc.rule</field>
        <field name="arch" type="xml">
            <list string="Cc / Bcc rules" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_ids" widget="many2many_tags" optional="show"/>
                <field name="user_ids" widget="many2many_avatar_user" optional="show"/>
                <field name="group_ids" widget="many2many_tags" optional="show"/>
                <field name="email_cc"/>
                <field name="email_bcc"/>
                <field name="reply_to" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="mail_cc_rule_view_form" model="ir.ui.view">
        <field name="name">mail.cc.rule.form</field>
        <field name="model">mail.cc.rule</field>
        <field name="arch" type="xml">
            <form string="Cc / Bcc rule">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Quotations: copy to the sales assistant"/></h1>
                    </div>
                    <group>
                        <group string="When" name="when">
                            <field name="model_ids" widget="many2many_tags" placeholder="All documents"
                                   options="{'no_create': True}"/>
                            <field name="user_ids" widget="many2many_avatar_user" placeholder="Everybody"/>
                            <field name="group_ids" widget="many2many_tags" placeholder="Everybody"
                                   options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company" placeholder="All companies"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Add" name="add">
                            <field name="email_cc" placeholder="assistant@company.com"/>
                            <field name="email_bcc" placeholder="archive@company.com"/>
                            <field name="reply_to" placeholder="sales@company.com"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        All conditions given must match. The Cc and Bcc of all matching rules are added to the company
                        defaults; the Reply-To of the first matching rule wins. Everything stays editable in the
                        composer.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mail_cc_rule" model="ir.actions.act_window">
        <field name="name">Cc / Bcc rules</field>
        <field name="res_model">mail.cc.rule</field>
        <field name="path">email-cc-rules</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add people in copy automatically</p>
            <p>For example: quotations sent by the sales team in Cc of the sales assistant, all invoices in Bcc of
                the archive mailbox.</p>
        </field>
    </record>

    <menuitem id="menu_mail_cc_rule" name="Cc / Bcc Rules" parent="base.menu_email"
              action="action_mail_cc_rule" sequence="40"/>
</odoo>
