<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_hubspot_sync" model="ir.cron">
        <field name="name">HubSpot: synchronize</field>
        <field name="model_id" ref="model_hubspot_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="ir_cron_hubspot_cleanup" model="ir.cron">
        <field name="name">HubSpot: clean old jobs and logs</field>
        <field name="model_id" ref="model_hubspot_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
