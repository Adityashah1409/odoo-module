<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_cod" model="res.groups.privilege">
        <field name="name">Cash on Delivery</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="sequence">40</field>
    </record>

    <record id="group_cod_driver" model="res.groups">
        <field name="name">Delivery person</field>
        <field name="privilege_id" ref="privilege_cod"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Sees the collections to do and confirms them with the customer's code.</field>
    </record>

</odoo>
