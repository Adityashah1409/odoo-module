<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_names" model="ir.ui.view">
        <field name="name">crm.lead.form.names</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[field[@id='contact_name']]" position="after">
                <label for="contact_first_name" string="First / last name"/>
                <div class="o_row">
                    <field name="contact_first_name" placeholder="First name"/>
                    <field name="contact_last_name" placeholder="Last name"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="crm_case_tree_view_leads_names" model="ir.ui.view">
        <field name="name">crm.lead.list.lead.names</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="arch" type="xml">
            <field name="contact_name" position="after">
                <field name="contact_first_name" optional="hide"/>
                <field name="contact_last_name" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
