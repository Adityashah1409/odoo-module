<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_warehouse_valuation_report_view_form" model="ir.ui.view">
        <field name="name">stock.warehouse.valuation.report.form</field>
        <field name="model">stock.warehouse.valuation.report</field>
        <field name="arch" type="xml">
            <form string="Warehouse Valuation">
                <group>
                    <field name="report_type" widget="radio"/>
                    <field name="warehouse_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="All warehouses"/>
                    <field name="categ_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="All categories"/>
                    <field name="include_empty"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <footer>
                    <button name="action_view" type="object" string="View" class="btn-primary"/>
                    <button name="action_xlsx" type="object" string="Excel" icon="table_chart"/>
                    <button name="action_pdf" type="object" string="PDF" icon="picture_as_pdf"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_stock_warehouse_valuation_report" model="ir.actions.act_window">
        <field name="name">Warehouse Valuation</field>
        <field name="res_model">stock.warehouse.valuation.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
