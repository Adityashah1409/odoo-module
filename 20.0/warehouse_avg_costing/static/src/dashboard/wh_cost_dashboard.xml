<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="warehouse_avg_costing.Dashboard">
        <div class="o_wh_cost_dashboard o_action h-100 overflow-auto">
            <div class="d-flex flex-wrap align-items-center gap-2 px-4 py-3 border-bottom">
                <h2 class="m-0 me-auto">Warehouse costing</h2>
                <button class="btn btn-secondary" t-on-click="this.openReport"><i class="oi me-1" data-icon="table_chart"/>Valuation report</button>
                <button class="btn btn-secondary" t-on-click="this.openHistory"><i class="oi me-1" data-icon="history"/>Cost history</button>
            </div>
            <div class="px-4 py-3" t-if="this.state.data">
                <t t-set="k" t-value="this.state.data.kpis"/>
                <div t-if="!k.enabled" class="alert alert-warning">Warehouse average costing is off for this company. Turn it on in Inventory › Settings › Valuation.</div>
                <div class="o_whc_kpis d-grid gap-3 mb-4">
                    <button class="card p-3 text-start o_whc_kpi" t-on-click="() => this.openCosts()"><span class="o_whc_label">Stock value</span>
                        <span class="o_whc_value" t-out="this.money(k.value)"/></button>
                    <div class="card p-3 o_whc_kpi"><span class="o_whc_label">Warehouses with stock</span><span class="o_whc_value" t-out="k.warehouses"/></div>
                    <div class="card p-3 o_whc_kpi"><span class="o_whc_label">Products costed</span><span class="o_whc_value" t-out="k.products"/></div>
                    <button class="card p-3 text-start o_whc_kpi" t-on-click="this.openHistory"><span class="o_whc_label">Cost changes (30 days)</span><span class="o_whc_value" t-out="k.changes"/></button>
                    <button class="card p-3 text-start o_whc_kpi" t-on-click="this.openPending"><span class="o_whc_label">Adjustments to approve</span>
                        <span t-attf-class="o_whc_value {{ k.pending ? 'text-warning' : '' }}" t-out="k.pending"/></button>
                </div>
                <div class="row g-4">
                    <div class="col-xl-7 d-flex flex-column gap-4">
                        <div class="card">
                            <div class="card-header"><strong>Value per warehouse</strong></div>
                            <div class="card-body d-flex flex-column gap-3">
                                <p t-if="!this.state.data.warehouses.length" class="text-muted mb-0">No warehouse cost yet.</p>
                                <div t-foreach="this.state.data.warehouses" t-as="wh" t-key="wh.code + wh.name" role="button" t-on-click="() => this.openCosts(wh.id)">
                                    <div class="d-flex justify-content-between"><span><strong t-out="wh.name"/> <small class="text-muted"><t t-out="wh.code"/> · <t t-out="wh.products"/> products</small></span>
                                        <span class="fw-semibold" t-out="this.money(wh.value)"/></div>
                                    <div class="progress o_whc_progress"><div class="progress-bar" t-att-style="this.width(wh.value, this.state.data.warehouses)"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="card">
                            <div class="card-header"><strong>Largest cost differences between warehouses</strong></div>
                            <table class="table table-sm table-hover mb-0">
                                <thead><tr><th>Product</th><th class="text-end">Lowest</th><th class="text-end">Highest</th><th class="text-end">Spread</th></tr></thead>
                                <tbody>
                                    <tr t-if="!this.state.data.spreads.length"><td colspan="4" class="text-muted text-center py-3">No product is stored in several warehouses.</td></tr>
                                    <tr t-foreach="this.state.data.spreads" t-as="s" t-key="s.id" role="button" t-on-click="() => this.openProduct(s.id)">
                                        <td t-out="s.name"/>
                                        <td class="text-end" t-out="this.cost(s.low)"/>
                                        <td class="text-end" t-out="this.cost(s.high)"/>
                                        <td class="text-end"><span t-attf-class="badge {{ s.spread &gt;= 10 ? 'text-bg-warning' : 'text-bg-light' }}"><t t-out="s.spread"/> %</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-xl-5 d-flex flex-column gap-4">
                        <div class="card">
                            <div class="card-header"><strong>Value by category</strong></div>
                            <div class="card-body d-flex flex-column gap-2">
                                <div t-foreach="this.state.data.categories" t-as="c" t-key="c.name">
                                    <div class="d-flex justify-content-between small"><span t-out="c.name"/><span t-out="this.money(c.value)"/></div>
                                    <div class="progress o_whc_progress"><div class="progress-bar bg-success" t-att-style="this.width(c.value, this.state.data.categories)"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="card">
                            <div class="card-header"><strong>Latest cost changes</strong></div>
                            <ul class="list-group list-group-flush">
                                <li t-if="!this.state.data.recent.length" class="list-group-item text-muted">Nothing yet.</li>
                                <li t-foreach="this.state.data.recent" t-as="r" t-key="r.id" class="list-group-item">
                                    <div class="d-flex justify-content-between">
                                        <span><strong t-out="r.product"/> <small class="text-muted">· <t t-out="r.warehouse"/></small></span>
                                        <span t-attf-class="badge o_whc_kind_{{ r.kind_key }}" t-out="r.kind"/>
                                    </div>
                                    <div class="d-flex justify-content-between small text-muted">
                                        <span t-out="this.formatDate(r.date)"/>
                                        <span><t t-out="this.cost(r.old)"/> → <strong class="text-body" t-out="this.cost(r.new)"/></span>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
