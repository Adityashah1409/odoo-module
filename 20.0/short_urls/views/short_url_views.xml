<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="short_url_view_list" model="ir.ui.view">
        <field name="name">short.url.list</field>
        <field name="model">short.url</field>
        <field name="arch" type="xml">
            <list decoration-muted="state != 'valid'" decoration-danger="state == 'expired'">
                <field name="token" class="fw-bold"/>
                <field name="short_url" optional="hide"/>
                <field name="name" optional="show"/>
                <field name="target_url"/>
                <field name="website_id" groups="website.group_multi_website" placeholder="All websites"/>
                <field name="channel_id" widget="badge" optional="show"/>
                <field name="campaign" optional="hide"/>
                <field name="click_count" sum="Clicks"/>
                <field name="last_click" optional="show"/>
                <field name="date_expire" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'valid'" decoration-danger="state == 'expired'"/>
                <button name="action_download_qr" type="object" icon="qr_code" title="Download the QR code"/>
            </list>
        </field>
    </record>

    <record id="short_url_view_form" model="ir.ui.view">
        <field name="name">short.url.form</field>
        <field name="model">short.url</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_target" type="object" string="Open target" icon="open_in_new"/>
                    <button name="action_download_qr" type="object" string="Download QR" icon="qr_code"/>
                    <button name="action_regenerate_token" type="object" string="New code"
                            confirm="The current short link and its QR code stop working. Continue?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_clicks" type="object" class="oe_stat_button" icon="arrow_selector_tool" icon_class="oi-filled">
                            <field name="click_count" string="Clicks" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger" invisible="state != 'expired'"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-secondary" invisible="state != 'archived'"/>
                    <div class="d-flex gap-4">
                        <div class="flex-grow-1">
                            <div class="oe_title">
                                <label for="token"/>
                                <h1 class="d-flex align-items-center"><span class="text-muted fs-4 me-1">/s/</span><field name="token" placeholder="spring-sale"/></h1>
                            </div>
                            <group>
                                <field name="short_url" widget="CopyClipboardChar" readonly="1"/>
                                <field name="target_url" widget="url" placeholder="/shop or https://..."/>
                                <field name="name" placeholder="e.g. Spring sale flyer"/>
                            </group>
                        </div>
                        <div class="text-center" style="width: 190px">
                            <field name="qr_code" widget="image" options="{'size': [180, 180]}" readonly="1"/>
                        </div>
                    </div>
                    <group>
                        <group string="Marketing">
                            <field name="channel_id" options="{'no_create_edit': True}"/>
                            <field name="campaign"/>
                            <field name="add_utm"/>
                        </group>
                        <group string="Validity">
                            <field name="website_id" groups="website.group_multi_website" placeholder="All websites"/>
                            <field name="date_expire"/>
                            <field name="last_click"/>
                            <field name="rule_id" invisible="not rule_id"/>
                            <field name="res_model" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Where is this link used? (flyer, post, e-mail, …)"/>
                        </page>
                        <page string="Last clicks" name="clicks">
                            <field name="click_ids" readonly="1">
                                <list limit="20">
                                    <field name="date"/>
                                    <field name="device"/>
                                    <field name="browser"/>
                                    <field name="country_id"/>
                                    <field name="referrer"/>
                                    <field name="is_bot" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="short_url_view_search" model="ir.ui.view">
        <field name="name">short.url.search</field>
        <field name="model">short.url</field>
        <field name="arch" type="xml">
            <search>
                <field name="token"/>
                <field name="target_url"/>
                <field name="name"/>
                <field name="channel_id"/>
                <field name="campaign"/>
                <filter name="valid" string="Valid" domain="[('state', '=', 'valid')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <filter name="global" string="All websites" domain="[('website_id', '=', False)]"/>
                <filter name="no_expiry" string="No expiry" domain="[('date_expire', '=', False)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="clicked" string="Clicked" domain="[('click_count', '>', 0)]"/>
                <filter name="automatic" string="From rules" domain="[('rule_id', '!=', False)]"/>
                <group>
                    <filter name="by_target" string="Target URL" context="{'group_by': 'target_url'}"/>
                    <filter name="by_website" string="Website" context="{'group_by': 'website_id'}"/>
                    <filter name="by_channel" string="Channel" context="{'group_by': 'channel_id'}"/>
                    <filter name="by_campaign" string="Campaign" context="{'group_by': 'campaign'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_short_url" model="ir.actions.act_window">
        <field name="name">Short URLs</field>
        <field name="res_model">short.url</field>
        <field name="path">short-urls</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a short link</p>
            <p>Short links like <b>/s/spring</b> redirect to any page; share them or print their QR code.</p>
        </field>
    </record>

    <record id="action_short_url_by_target" model="ir.actions.act_window">
        <field name="name">Short URLs by target</field>
        <field name="res_model">short.url</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_by_target': 1}</field>
    </record>

    <!-- channels -->
    <record id="short_url_channel_view_list" model="ir.ui.view">
        <field name="name">short.url.channel.list</field>
        <field name="model">short.url.channel</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="utm_source"/>
                <field name="utm_medium"/>
                <field name="color" widget="color_picker"/>
                <field name="link_count" string="Links"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_short_url_channel" model="ir.actions.act_window">
        <field name="name">Short URL Channels</field>
        <field name="res_model">short.url.channel</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
