<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cloud_storage_rule_list" model="ir.ui.view">
        <field name="name">cloud.storage.rule.list</field>
        <field name="model">cloud.storage.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="parent_id"/>
                <field name="client_id"/>
                <field name="folder_count" string="Folders"/>
            </list>
        </field>
    </record>

    <record id="view_cloud_storage_rule_form" model="ir.ui.view">
        <field name="name">cloud.storage.rule.form</field>
        <field name="model">cloud.storage.rule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate" type="object" string="Generate folders now" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_folders" type="object" class="oe_stat_button" icon="folder" icon_class="oi-filled">
                            <field name="folder_count" widget="statinfo" string="Folders"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Customers"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="client_id" readonly="parent_id"/>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="model_name" invisible="1"/>
                            <field name="parent_id"/>
                            <field name="parent_field_id" invisible="not parent_id" required="parent_id"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="name_expression"/>
                            <field name="subfolder_names" placeholder="Contracts, Photos"/>
                            <field name="max_folders"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <separator string="Records that get a folder"/>
                    <field name="domain" widget="domain" options="{'model': 'model_name', 'in_dialog': True}"/>
                    <separator string="Child rules" invisible="not id"/>
                    <field name="child_ids" invisible="not id" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="model_id"/>
                            <field name="parent_field_id"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cloud_storage_rule" model="ir.actions.act_window">
        <field name="name">Folder Rules</field>
        <field name="res_model">cloud.storage.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a folder rule</p>
            <p>A rule creates one folder per record (customers, projects, employees...) and keeps it in sync.</p>
        </field>
    </record>
</odoo>
