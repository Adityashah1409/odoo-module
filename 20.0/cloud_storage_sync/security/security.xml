<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_cloud_storage" model="res.groups.privilege">
        <field name="name">Cloud Storage</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_cloud_storage_user" model="res.groups">
        <field name="name">File Manager</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_cloud_storage"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_cloud_storage_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_cloud_storage"/>
        <field name="implied_ids" eval="[Command.link(ref('group_cloud_storage_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

</odoo>
