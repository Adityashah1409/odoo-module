<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.chatter.pin</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="discuss" position="inside">
                <setting id="chatter_pin_setting" string="Pinned messages"
                         help="Who can pin messages in the chatter of a record, and how many.">
                    <div class="mt-2">
                        <label for="chatter_pin_access" class="o_light_label me-2"/>
                        <field name="chatter_pin_access" class="oe_inline"/>
                    </div>
                    <div>
                        <label for="chatter_pin_max" class="o_light_label me-2"/>
                        <field name="chatter_pin_max" class="oe_inline o_input_4ch"/>
                        <span class="text-muted ms-1">(0 = no limit)</span>
                    </div>
                    <div class="mt-1">
                        <button name="%(chatter_pin_message.action_pinned_messages)d" type="action" icon="east"
                                string="All pinned messages" class="btn-link"/>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>
