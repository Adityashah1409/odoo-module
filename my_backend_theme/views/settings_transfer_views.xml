<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="my_theme_settings_transfer_view_form" model="ir.ui.view">
        <field name="name">my.theme.settings.transfer.form</field>
        <field name="model">my.theme.settings.transfer</field>
        <field name="arch" type="xml">
            <form string="Import Theme Settings">
                <field name="state" invisible="1"/>
                <div invisible="state != 'upload'">
                    <p class="text-muted">
                        Choose a file exported from Settings, Backend Theme, Export Settings.
                        Its settings replace the current ones; invalid values are skipped.
                    </p>
                    <group>
                        <field name="file" filename="filename" required="state == 'upload'"/>
                        <field name="filename" invisible="1"/>
                        <field name="include_entries"/>
                    </group>
                </div>
                <div invisible="state != 'done'">
                    <field name="result_message" class="o_mbt_import_result" style="white-space: pre-line"/>
                    <p class="text-muted mb-0">Reload the page to apply the imported settings.</p>
                </div>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"
                            invisible="state != 'upload'"/>
                    <button special="cancel" string="Cancel" class="btn-secondary" invisible="state != 'upload'"/>
                    <button name="action_reload" type="object" string="Reload" class="btn-primary"
                            invisible="state != 'done'"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
