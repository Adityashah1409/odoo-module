<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cpq_configure_wizard" model="ir.ui.view">
        <field name="name">cpq.configure.wizard.form</field>
        <field name="model">cpq.configure.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="configurator_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="order_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="quantity"/>
                        <field name="total_price"/>
                    </group>
                </group>
                <field name="description" invisible="not description" readonly="1"/>
                <div class="row" invisible="not configurator_id">
                    <div class="col-lg-7">
                        <field name="line_ids" nolabel="1">
                            <list editable="bottom" create="false" delete="false"
                                  decoration-muted="not available" decoration-bf="selected">
                                <field name="section_name"/>
                                <field name="option_id" readonly="1" force_save="1"/>
                                <field name="selected" widget="boolean_toggle" readonly="not available"/>
                                <field name="quantity" readonly="not selected"/>
                                <field name="unit_price"/>
                                <field name="stock_qty" optional="show" decoration-danger="not stock_ok"/>
                                <field name="available" column_invisible="1"/>
                                <field name="stock_ok" column_invisible="1"/>
                            </list>
                        </field>
                    </div>
                    <div class="col-lg-5">
                        <field name="breakdown_html" nolabel="1"/>
                        <div class="alert alert-warning mt-2" role="alert" invisible="not problems">
                            <field name="problems" nolabel="1"/>
                        </div>
                    </div>
                </div>
                <footer>
                    <button name="action_add_to_order" type="object" string="Add to quotation" class="btn-primary"
                            invisible="not configurator_id"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
