<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cpq_configuration_list" model="ir.ui.view">
        <field name="name">cpq.configuration.list</field>
        <field name="model">cpq.configuration</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="name"/>
                <field name="configurator_id"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="quantity"/>
                <field name="price_unit" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="product_id" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_cpq_configuration_form" model="ir.ui.view">
        <field name="name">cpq.configuration.form</field>
        <field name="model">cpq.configuration</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_productions" type="object" class="oe_stat_button" icon="fa-wrench"
                                invisible="not production_ids" string="Manufacturing"/>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="configurator_id"/>
                            <field name="order_id"/>
                            <field name="partner_id"/>
                            <field name="quantity"/>
                        </group>
                        <group>
                            <field name="price_unit" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="product_id"/>
                            <field name="bom_id"/>
                            <field name="production_ids" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="section_name"/>
                            <field name="option_id"/>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="subtotal" sum="Options"/>
                        </list>
                    </field>
                    <separator string="Summary"/>
                    <field name="summary"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cpq_configuration" model="ir.actions.act_window">
        <field name="name">Configurations</field>
        <field name="res_model">cpq.configuration</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
