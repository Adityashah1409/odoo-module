<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_compose_message_view_form_cc" model="ir.ui.view">
        <field name="name">mail.compose.message.form.cc.bcc</field>
        <field name="model">mail.compose.message</field>
        <field name="inherit_id" ref="mail.email_compose_message_wizard_form"/>
        <field name="arch" type="xml">
            <field name="subject" position="before">
                <field name="extra_email_cc" placeholder="e.g. manager@company.com, assistant@company.com"
                       invisible="subtype_is_log"/>
                <field name="extra_email_bcc" placeholder="Hidden copies" invisible="subtype_is_log"/>
            </field>
            <field name="subject" position="after">
                <field name="reply_to" string="Reply-To" placeholder="Empty: replies come back in the chatter"
                       invisible="composition_mode != 'comment' or subtype_is_log or reply_to_mode != 'update'"/>
            </field>
        </field>
    </record>
</odoo>
