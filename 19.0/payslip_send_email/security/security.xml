<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_payslip" model="res.groups.privilege">
        <field name="name">Payslip distribution</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>
    <record id="group_payslip_officer" model="res.groups">
        <field name="name">Officer</field>
        <field name="privilege_id" ref="privilege_payslip"/>
        <field name="implied_ids" eval="[Command.link(ref('hr.group_hr_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Imports and sends the payslips of all employees.</field>
    </record>

    <record id="rule_payslip_document_own" model="ir.rule">
        <field name="name">Payslips: own payslips</field>
        <field name="model_id" ref="model_hr_payslip_document"/>
        <field name="domain_force">[('user_id', '=', user.id), ('state', '=', 'sent')]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_payslip_document_officer" model="ir.rule">
        <field name="name">Payslips: officers</field>
        <field name="model_id" ref="model_hr_payslip_document"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_payslip_officer'))]"/>
    </record>
    <record id="rule_payslip_document_company" model="ir.rule">
        <field name="name">Payslips: companies</field>
        <field name="model_id" ref="model_hr_payslip_document"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_payslip_batch_company" model="ir.rule">
        <field name="name">Payslip batches: companies</field>
        <field name="model_id" ref="model_hr_payslip_document_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
