<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payslip_document_batch_view_list" model="ir.ui.view">
        <field name="name">hr.payslip.document.batch.list</field>
        <field name="model">hr.payslip.document.batch</field>
        <field name="arch" type="xml">
            <list string="Payslip batches" sample="1">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="count_total" string="Payslips"/>
                <field name="count_sent"/>
                <field name="count_error"/>
                <field name="scheduled_date" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'scheduled'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="hr_payslip_document_batch_view_form" model="ir.ui.view">
        <field name="name">hr.payslip.document.batch.form</field>
        <field name="model">hr.payslip.document.batch</field>
        <field name="arch" type="xml">
            <form string="Payslip batch">
                <header>
                    <button name="action_open_import" type="object" string="Import PDFs" class="btn-primary"
                            invisible="state == 'done'"/>
                    <button name="action_send_all" type="object" string="Send now" invisible="not count_draft and not count_error"
                            confirm="E-mail the payslips to the employees now?"/>
                    <button name="action_schedule" type="object" string="Schedule" invisible="state != 'draft' or not count_draft"/>
                    <button name="action_unschedule" type="object" string="Cancel schedule" invisible="state != 'scheduled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <div class="alert alert-warning mb-0 rounded-0" role="alert" invisible="not count_unassigned">
                    <field name="count_unassigned" readonly="1" class="fw-bold"/> payslip(s) could not be matched to an
                    employee: choose the employee in the list below.
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-file-pdf-o">
                            <field name="count_total" widget="statinfo" string="Payslips"/>
                        </button>
                        <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-paper-plane">
                            <field name="count_sent" widget="statinfo" string="Sent"/>
                        </button>
                        <button name="action_view_documents" type="object" class="oe_stat_button text-danger"
                                icon="fa-exclamation-triangle" invisible="not count_error">
                            <field name="count_error" widget="statinfo" string="Not sent"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Payslips October 2026"/></h1>
                    </div>
                    <group>
                        <group>
                            <label for="date_from" string="Period"/>
                            <div class="o_row">
                                <field name="date_from" readonly="state == 'done'"/> -
                                <field name="date_to" readonly="state == 'done'"/>
                            </div>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="scheduled_date" readonly="state != 'draft'"/>
                            <field name="count_draft" invisible="1"/>
                            <field name="count_error" invisible="1"/>
                        </group>
                    </group>
                    <field name="document_ids" context="{'default_date_from': date_from, 'default_date_to': date_to, 'default_company_id': company_id}">
                        <list editable="bottom" decoration-danger="state == 'error'" decoration-muted="state == 'cancel'" create="false">
                            <field name="employee_id" widget="many2one_avatar_employee"
                                   readonly="state not in ('draft', 'error')"/>
                            <field name="department_id" optional="show"/>
                            <field name="pdf_filename" readonly="1"/>
                            <field name="sent_to" readonly="1" optional="show"/>
                            <field name="error_message" readonly="1" optional="show"/>
                            <field name="date_from" column_invisible="True"/>
                            <field name="date_to" column_invisible="True"/>
                            <field name="pdf_file" column_invisible="True"/>
                            <field name="company_id" column_invisible="True"/>
                            <field name="state" widget="badge" decoration-info="state == 'draft'"
                                   decoration-success="state == 'sent'" decoration-danger="state == 'error'"/>
                            <button name="action_send" type="object" icon="fa-paper-plane" title="Send"
                                    invisible="state not in ('draft', 'error') or not employee_id"/>
                            <button name="action_download" type="object" icon="fa-download" title="Download"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_payslip_document_batch" model="ir.actions.act_window">
        <field name="name">Payslip batches</field>
        <field name="res_model">hr.payslip.document.batch</field>
        <field name="path">payslip-batches</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Distribute this month's payslips</p>
            <p>Create a batch, import the PDFs of your payroll provider (or a ZIP), check the matching, send.</p>
        </field>
    </record>
</odoo>
