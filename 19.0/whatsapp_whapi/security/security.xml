<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_whatsapp" model="ir.module.category">
        <field name="name">WhatsApp</field>
        <field name="sequence">30</field>
    </record>

    <record id="privilege_whatsapp" model="res.groups.privilege">
        <field name="name">WhatsApp (Whapi)</field>
        <field name="category_id" ref="module_category_whatsapp"/>
    </record>

    <record id="group_whapi_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_whatsapp"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Chat on the WhatsApp accounts they are allowed on, send documents by WhatsApp.</field>
    </record>

    <record id="group_whapi_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_whatsapp"/>
        <field name="implied_ids" eval="[Command.link(ref('group_whapi_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Configure accounts and templates, see every chat.</field>
    </record>

    <record id="rule_whapi_account_user" model="ir.rule">
        <field name="name">WhatsApp account: allowed users</field>
        <field name="model_id" ref="model_whapi_account"/>
        <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('user_ids', '=', False), ('user_ids', 'in', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_whapi_user'))]"/>
    </record>
    <record id="rule_whapi_account_manager" model="ir.rule">
        <field name="name">WhatsApp account: administrators (own companies)</field>
        <field name="model_id" ref="model_whapi_account"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('group_whapi_manager'))]"/>
    </record>

    <record id="rule_whapi_chat_user" model="ir.rule">
        <field name="name">WhatsApp chat: accounts of the user</field>
        <field name="model_id" ref="model_whapi_chat"/>
        <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('account_id.user_ids', '=', False), ('account_id.user_ids', 'in', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_whapi_user'))]"/>
    </record>
    <record id="rule_whapi_chat_manager" model="ir.rule">
        <field name="name">WhatsApp chat: administrators (own companies)</field>
        <field name="model_id" ref="model_whapi_chat"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('group_whapi_manager'))]"/>
    </record>

    <record id="rule_whapi_message_user" model="ir.rule">
        <field name="name">WhatsApp message: accounts of the user</field>
        <field name="model_id" ref="model_whapi_message"/>
        <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('account_id.user_ids', '=', False), ('account_id.user_ids', 'in', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_whapi_user'))]"/>
    </record>
    <record id="rule_whapi_message_manager" model="ir.rule">
        <field name="name">WhatsApp message: administrators (own companies)</field>
        <field name="model_id" ref="model_whapi_message"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('group_whapi_manager'))]"/>
    </record>
</odoo>
