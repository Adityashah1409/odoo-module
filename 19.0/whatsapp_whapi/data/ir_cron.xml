<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_whapi_check" model="ir.cron">
        <field name="name">WhatsApp (Whapi): check the connection of the accounts</field>
        <field name="model_id" ref="model_whapi_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_connections()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
