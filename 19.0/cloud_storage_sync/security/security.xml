<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_cloud_storage" model="res.groups.privilege">
        <field name="name">Cloud Storage</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_cloud_storage_user" model="res.groups">
        <field name="name">File Manager</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_cloud_storage"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_cloud_storage_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_cloud_storage"/>
        <field name="implied_ids" eval="[Command.link(ref('group_cloud_storage_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_folder_restricted" model="ir.rule">
            <field name="name">Cloud folders: user and group restrictions</field>
            <field name="model_id" ref="model_cloud_storage_folder"/>
            <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
            <field name="domain_force">['|', '&amp;', ('user_ids', '=', False), ('group_ids', '=', False), '|', ('user_ids', 'in', [user.id]), ('group_ids', 'in', user.all_group_ids.ids)]</field>
        </record>
        <record id="rule_folder_manager" model="ir.rule">
            <field name="name">Cloud folders: administrators see everything</field>
            <field name="model_id" ref="model_cloud_storage_folder"/>
            <field name="groups" eval="[Command.link(ref('group_cloud_storage_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_client_company" model="ir.rule">
            <field name="name">Cloud clients: multi-company</field>
            <field name="model_id" ref="model_cloud_storage_client"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
    </data>
</odoo>
