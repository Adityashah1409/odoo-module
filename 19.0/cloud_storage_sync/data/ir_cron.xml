<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_generate_folders" model="ir.cron">
            <field name="name">Cloud Storage: generate folders from rules</field>
            <field name="model_id" ref="model_cloud_storage_rule"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_folders()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
        </record>
        <record id="ir_cron_process_queue" model="ir.cron">
            <field name="name">Cloud Storage: process sync queue</field>
            <field name="model_id" ref="model_cloud_storage_queue"/>
            <field name="state">code</field>
            <field name="code">model._cron_process()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
        </record>
        <record id="ir_cron_backward_sync" model="ir.cron">
            <field name="name">Cloud Storage: backward sync (cloud to Odoo)</field>
            <field name="model_id" ref="model_cloud_storage_client"/>
            <field name="state">code</field>
            <field name="code">model._cron_backward_sync()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
        </record>
    </data>
</odoo>
