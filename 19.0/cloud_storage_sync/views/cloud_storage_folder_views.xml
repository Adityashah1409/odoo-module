<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cloud_storage_folder_list" model="ir.ui.view">
        <field name="name">cloud.storage.folder.list</field>
        <field name="model">cloud.storage.folder</field>
        <field name="arch" type="xml">
            <list>
                <field name="complete_name" string="Folder"/>
                <field name="client_id"/>
                <field name="rule_id" optional="show"/>
                <field name="res_model" optional="hide"/>
                <field name="attachment_count" string="Files"/>
                <field name="sync_state" widget="badge" decoration-success="sync_state == 'synced'"
                       decoration-danger="sync_state == 'error'"/>
            </list>
        </field>
    </record>

    <record id="view_cloud_storage_folder_form" model="ir.ui.view">
        <field name="name">cloud.storage.folder.form</field>
        <field name="model">cloud.storage.folder</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_download_zip" type="object" string="Download ZIP" invisible="not id"/>
                    <button name="action_open_in_cloud" type="object" string="Open in cloud"
                            invisible="sync_state != 'synced'"/>
                    <field name="sync_state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_files" type="object" class="oe_stat_button" icon="fa-file">
                            <field name="attachment_count" widget="statinfo" string="Files"/>
                        </button>
                        <button name="action_open_record" type="object" class="oe_stat_button" icon="fa-external-link"
                                string="Linked record" invisible="not res_model"/>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="not manual"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="parent_id" readonly="not manual"/>
                            <field name="client_id" readonly="parent_id or not manual"/>
                            <field name="remote_path"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="manual"/>
                            <field name="rule_id" invisible="manual"/>
                            <field name="res_model" invisible="not res_model"/>
                            <field name="res_id" invisible="not res_model"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Files" name="files">
                            <field name="attachment_ids" mode="list" context="{'default_cloud_folder_id': id}">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="datas" string="File" filename="name" widget="binary"/>
                                    <field name="file_size" widget="integer"/>
                                    <field name="cloud_state" widget="badge" decoration-success="cloud_state == 'synced'"
                                           decoration-danger="cloud_state in ('error', 'missing')"/>
                                    <button name="action_open_in_cloud" type="object" icon="fa-cloud" title="Open in cloud"
                                            invisible="cloud_state != 'synced'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Subfolders" name="subfolders">
                            <field name="child_ids" context="{'default_client_id': client_id}">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="attachment_count" string="Files"/>
                                    <field name="sync_state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Access" name="access" invisible="not manual">
                            <group>
                                <field name="user_ids" widget="many2many_tags"/>
                                <field name="group_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cloud_storage_folder_search" model="ir.ui.view">
        <field name="name">cloud.storage.folder.search</field>
        <field name="model">cloud.storage.folder</field>
        <field name="arch" type="xml">
            <search>
                <field name="complete_name" string="Folder"/>
                <field name="client_id"/>
                <field name="rule_id"/>
                <filter name="manual" string="Manual folders" domain="[('manual', '=', True)]"/>
                <filter name="auto" string="Rule folders" domain="[('manual', '=', False)]"/>
                <filter name="error" string="Sync errors" domain="[('sync_state', '=', 'error')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_client" string="Client" context="{'group_by': 'client_id'}"/>
                    <filter name="group_rule" string="Rule" context="{'group_by': 'rule_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cloud_storage_folder" model="ir.actions.act_window">
        <field name="name">Folders</field>
        <field name="res_model">cloud.storage.folder</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_manual': True}</field>
    </record>
</odoo>
