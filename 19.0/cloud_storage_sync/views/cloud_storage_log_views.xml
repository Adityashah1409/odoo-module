<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cloud_storage_log_list" model="ir.ui.view">
        <field name="name">cloud.storage.log.list</field>
        <field name="model">cloud.storage.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" decoration-danger="level == 'error'" decoration-warning="level == 'warning'">
                <field name="create_date" string="Date"/>
                <field name="client_id"/>
                <field name="level"/>
                <field name="message"/>
                <field name="folder_id" optional="hide"/>
                <field name="attachment_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_cloud_storage_log_search" model="ir.ui.view">
        <field name="name">cloud.storage.log.search</field>
        <field name="model">cloud.storage.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="message"/>
                <field name="client_id"/>
                <filter name="errors" string="Errors" domain="[('level', '=', 'error')]"/>
                <filter name="warnings" string="Warnings" domain="[('level', '=', 'warning')]"/>
            </search>
        </field>
    </record>

    <record id="action_cloud_storage_log" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">cloud.storage.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
