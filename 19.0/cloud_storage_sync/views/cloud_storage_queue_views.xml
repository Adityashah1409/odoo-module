<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cloud_storage_queue_list" model="ir.ui.view">
        <field name="name">cloud.storage.queue.list</field>
        <field name="model">cloud.storage.queue</field>
        <field name="arch" type="xml">
            <list create="false" decoration-danger="state == 'failed'" decoration-muted="state == 'done'">
                <header>
                    <button name="action_requeue" type="object" string="Retry"/>
                    <button name="action_run_now" type="object" string="Run now"/>
                </header>
                <field name="create_date"/>
                <field name="client_id"/>
                <field name="operation"/>
                <field name="folder_id"/>
                <field name="attachment_id"/>
                <field name="path" optional="show"/>
                <field name="new_path" optional="hide"/>
                <field name="attempts"/>
                <field name="error" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_cloud_storage_queue_search" model="ir.ui.view">
        <field name="name">cloud.storage.queue.search</field>
        <field name="model">cloud.storage.queue</field>
        <field name="arch" type="xml">
            <search>
                <field name="client_id"/>
                <field name="path"/>
                <filter name="todo" string="To do" domain="[('state', '=', 'todo')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <group>
                    <filter name="group_operation" string="Operation" context="{'group_by': 'operation'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cloud_storage_queue" model="ir.actions.act_window">
        <field name="name">Sync Queue</field>
        <field name="res_model">cloud.storage.queue</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_todo': 1, 'search_default_failed': 1}</field>
    </record>
</odoo>
