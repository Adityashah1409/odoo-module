<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//button[@aria-label='Search Messages']" position="before">
            <button class="o_chatter_order_toggle btn btn-link text-action text-nowrap px-1" t-att-title="chatterOrderTitle"
                    aria-label="Sort messages by date" t-on-click="onClickChatterOrder"
                    t-att-disabled="!state.thread?.id">
                <i t-att-class="state.chatterOrder === 'asc' ? 'fa fa-sort-amount-asc' : 'fa fa-sort-amount-desc'" role="img"/>
                <span class="o_chatter_order_label ms-1 small" t-esc="chatterOrderLabel"/>
            </button>
        </xpath>
        <xpath expr="//Thread" position="attributes">
            <attribute name="order">state.chatterOrder</attribute>
        </xpath>
    </t>
</templates>
