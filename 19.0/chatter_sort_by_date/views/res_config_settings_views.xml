<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.chatter.order</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="discuss" position="inside">
                <setting id="chatter_order_setting" string="Chatter order"
                         help="Order of the messages in the chatter for users who did not choose their own.">
                    <field name="chatter_default_order" widget="radio" options="{'horizontal': true}"/>
                </setting>
            </block>
        </field>
    </record>
</odoo>
