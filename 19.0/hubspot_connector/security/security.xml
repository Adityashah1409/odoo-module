<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_hubspot" model="res.groups.privilege">
        <field name="name">HubSpot</field>
        <field name="sequence">60</field>
    </record>
    <record id="group_hubspot_manager" model="res.groups">
        <field name="name">Configuration Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_hubspot"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Configure HubSpot accounts, run and monitor the synchronization.</field>
    </record>
    <record id="rule_hubspot_account_company" model="ir.rule">
        <field name="name">HubSpot account: multi-company</field>
        <field name="model_id" ref="model_hubspot_account"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
