                    <div class="o_stat_info"><span class="o_stat_text">HubSpot</span>
                        <span class="o_stat_value"><field name="hubspot_id"/></span></div>
                </button>
                <field name="hubspot_url" invisible="1"/>
            </div>
        </field>
    </record>
    <record id="account_move_form_hubspot" model="ir.ui.view">
        <field name="name">account.move.form.hubspot</field>
