<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- "HubSpot" smart button on synchronized records -->
    <record id="view_partner_form_hubspot" model="ir.ui.view">
        <field name="name">res.partner.form.hubspot</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_hubspot" type="object" class="oe_stat_button" icon="fa-external-link"
                        groups="hubspot_connector.group_hubspot_manager" invisible="not hubspot_url">
                    <div class="o_stat_info"><span class="o_stat_text">HubSpot</span>
                        <span class="o_stat_value"><field name="hubspot_id"/></span></div>
                </button>
                <field name="hubspot_url" invisible="1"/>
            </div>
        </field>
    </record>
