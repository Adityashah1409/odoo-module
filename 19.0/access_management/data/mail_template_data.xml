<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_template_export_alert" model="mail.template">
        <field name="name">Access Management: large export</field>
        <field name="model_id" ref="model_access_export_log"/>
        <field name="subject">Large export: {{ object.record_count }} {{ object.model_name or object.model }} by {{ object.user_id.name }}</field>
        <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div>
    <p><strong t-out="object.user_id.name or ''"/> exported <strong t-out="object.record_count"/> records of
        <t t-out="object.model_name or object.model or ''"/> on <t t-out="format_datetime(object.create_date) or ''"/>.</p>
    <p>Columns: <t t-out="object.field_names or ''"/></p>
    <p t-if="object.ip_address">IP address: <t t-out="object.ip_address"/></p>
    <p>This message was sent because the export is above the alert threshold set in Access Management.</p>
</div>
        </field>
    </record>

    <record id="mail_template_lock_alert" model="mail.template">
        <field name="name">Access Management: PIN lockout</field>
        <field name="model_id" ref="model_access_menu_lock"/>
        <field name="subject">Locked menu: {{ object.menu_id.complete_name }}</field>
        <field name="email_from">{{ user.company_id.email_formatted or user.email_formatted }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div>
    <p><strong t-out="ctx.get('locked_user') or ''"/> entered a wrong code too many times for the menu
        <strong t-out="object.menu_id.complete_name or ''"/>.</p>
    <p>The menu is locked for <t t-out="object.lockout_minutes"/> minutes for this user.</p>
</div>
        </field>
    </record>
</odoo>
