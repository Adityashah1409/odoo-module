<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_access_rules" model="ir.ui.view">
        <field name="name">res.users.form.access.rules</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_access_rules" type="object" class="oe_stat_button" icon="fa-shield"
                        groups="access_management.group_access_manager">
                    <field name="access_rule_count" widget="statinfo" string="Access rules"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
