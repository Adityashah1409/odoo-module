<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_support" model="res.groups.privilege">
        <field name="name">Helpdesk</field>
        <field name="sequence">40</field>
    </record>
    <record id="group_support_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_support"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Tickets of their teams, assigned to them, or without team.</field>
    </record>
    <record id="group_support_leader" model="res.groups">
        <field name="name">Team Leader</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_support"/>
        <field name="implied_ids" eval="[(4, ref('group_support_user'))]"/>
        <field name="comment">+ every ticket of the teams they lead, ratings and reports.</field>
    </record>
    <record id="group_support_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_support"/>
        <field name="implied_ids" eval="[(4, ref('group_support_leader'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">All tickets and the configuration.</field>
    </record>

    <!-- tickets -->
    <record id="rule_ticket_company" model="ir.rule">
        <field name="name">Ticket: multi-company</field>
        <field name="model_id" ref="model_support_ticket"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_ticket_user" model="ir.rule">
        <field name="name">Ticket: own teams, own tickets, no team</field>
        <field name="model_id" ref="model_support_ticket"/>
        <field name="domain_force">['|', '|', '|', '|', ('team_id', '=', False), ('team_id.member_ids', 'in', [user.id]),
            ('user_id', '=', user.id), ('assignee_ids', 'in', [user.id]), ('message_partner_ids', 'in', [user.partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('group_support_user'))]"/>
    </record>
    <record id="rule_ticket_leader" model="ir.rule">
        <field name="name">Ticket: teams led</field>
        <field name="model_id" ref="model_support_ticket"/>
        <field name="domain_force">[('team_id.leader_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_support_leader'))]"/>
    </record>
    <record id="rule_ticket_manager" model="ir.rule">
        <field name="name">Ticket: all</field>
        <field name="model_id" ref="model_support_ticket"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_support_manager'))]"/>
    </record>
    <record id="rule_ticket_portal" model="ir.rule">
        <field name="name">Ticket: portal users see their company's tickets</field>
        <field name="model_id" ref="model_support_ticket"/>
        <field name="domain_force">['|', ('partner_id', 'child_of', [user.commercial_partner_id.id]),
            ('message_partner_ids', 'in', [user.partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- teams and SLA per company -->
    <record id="rule_team_company" model="ir.rule">
        <field name="name">Team: multi-company</field>
        <field name="model_id" ref="model_support_team"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_sla_company" model="ir.rule">
        <field name="name">SLA: multi-company</field>
        <field name="model_id" ref="model_support_sla"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
