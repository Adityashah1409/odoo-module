<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="support_stage_view_list" model="ir.ui.view">
        <field name="name">support.stage.list</field>
        <field name="model">support.stage</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_closed"/>
                <field name="fold"/>
                <field name="team_ids" widget="many2many_tags"/>
                <field name="template_id"/>
                <field name="color" widget="color"/>
            </list>
        </field>
    </record>
    <record id="support_stage_view_form" model="ir.ui.view">
        <field name="name">support.stage.form</field>
        <field name="model">support.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="is_closed"/>
                            <field name="fold"/>
                            <field name="color" widget="color"/>
                        </group>
                        <group>
                            <field name="team_ids" widget="many2many_tags"/>
                            <field name="template_id" context="{'default_model': 'support.ticket'}"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What this stage means for the agents"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_support_stage" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">support.stage</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="support_ticket_type_view_list" model="ir.ui.view">
        <field name="name">support.ticket.type.list</field>
        <field name="model">support.ticket.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="action_support_ticket_type" model="ir.actions.act_window">
        <field name="name">Ticket Types</field>
        <field name="res_model">support.ticket.type</field>
        <field name="view_mode">list</field>
    </record>

    <record id="support_category_view_list" model="ir.ui.view">
        <field name="name">support.category.list</field>
        <field name="model">support.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="complete_name" column_invisible="1"/>
                <field name="name"/>
                <field name="parent_id"/>
            </list>
        </field>
    </record>
    <record id="action_support_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">support.category</field>
        <field name="view_mode">list</field>
    </record>

    <record id="support_tag_view_list" model="ir.ui.view">
        <field name="name">support.tag.list</field>
        <field name="model">support.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>
    <record id="action_support_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">support.tag</field>
        <field name="view_mode">list</field>
    </record>

    <record id="support_checklist_template_view_list" model="ir.ui.view">
        <field name="name">support.checklist.template.list</field>
        <field name="model">support.checklist.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="type_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
    <record id="support_checklist_template_view_form" model="ir.ui.view">
        <field name="name">support.checklist.template.form</field>
        <field name="model">support.checklist.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Hardware return"/></h1></div>
                    <group><field name="type_ids" widget="many2many_tags"/></group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_support_checklist_template" model="ir.actions.act_window">
        <field name="name">Checklists</field>
        <field name="res_model">support.checklist.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
