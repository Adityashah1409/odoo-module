<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_refresh_positions" model="ir.cron">
            <field name="name">Traccar: refresh live positions</field>
            <field name="model_id" ref="model_traccar_server"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_positions()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
        </record>
        <record id="ir_cron_import_trips" model="ir.cron">
            <field name="name">Traccar: import trips of the last 24 hours</field>
            <field name="model_id" ref="model_traccar_server"/>
            <field name="state">code</field>
            <field name="code">model._cron_import_trips()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>
