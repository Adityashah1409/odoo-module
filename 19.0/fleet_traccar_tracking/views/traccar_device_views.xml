<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_traccar_device_list" model="ir.ui.view">
        <field name="name">traccar.device.list</field>
        <field name="model">traccar.device</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="false">
                <field name="name" readonly="1"/>
                <field name="unique_id" readonly="1"/>
                <field name="vehicle_id"/>
                <field name="tracking_enabled" widget="boolean_toggle"/>
                <field name="server_id" optional="hide" readonly="1"/>
                <field name="last_update"/>
                <field name="status" widget="badge" decoration-success="status == 'online'" decoration-muted="status != 'online'"/>
            </list>
        </field>
    </record>

    <record id="view_traccar_device_form" model="ir.ui.view">
        <field name="name">traccar.device.form</field>
        <field name="model">traccar.device</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_positions" type="object" class="oe_stat_button" icon="fa-map-marker">
                            <field name="position_count" widget="statinfo" string="Positions"/>
                        </button>
                        <button name="action_view_trips" type="object" class="oe_stat_button" icon="fa-road">
                            <field name="trip_count" widget="statinfo" string="Trips"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="tracking_enabled" widget="boolean_toggle"/>
                            <field name="status"/>
                            <field name="last_update"/>
                        </group>
                        <group>
                            <field name="server_id" readonly="1"/>
                            <field name="traccar_id" readonly="1"/>
                            <field name="unique_id" readonly="1"/>
                            <field name="phone" readonly="1"/>
                            <field name="model" readonly="1"/>
                            <field name="disabled"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_traccar_device_search" model="ir.ui.view">
        <field name="name">traccar.device.search</field>
        <field name="model">traccar.device</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="unique_id"/>
                <field name="vehicle_id"/>
                <filter name="online" string="Online" domain="[('status', '=', 'online')]"/>
                <filter name="unlinked" string="Not linked to a vehicle" domain="[('vehicle_id', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_traccar_device" model="ir.actions.act_window">
        <field name="name">GPS Devices</field>
        <field name="res_model">traccar.device</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
