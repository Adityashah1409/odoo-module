<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="login_as_user.Systray">
        <div class="o_login_as_systray d-flex align-items-center h-100">
            <t t-if="info.origin">
                <div class="o_login_as_pill d-flex align-items-center gap-2 px-2 py-1 rounded-pill me-1">
                    <i class="fa fa-user-secret" title="Logged in as another user"/>
                    <span class="d-none d-md-inline">As <b t-esc="userName"/></span>
                    <span t-if="state.remaining" class="o_login_as_timer rounded-pill px-2 bg-white text-danger fw-bold"
                          title="Time left before switching back" t-esc="remainingLabel"/>
                    <button t-if="info.can" class="btn btn-sm btn-link text-white p-0 o_login_as_other"
                            title="Log in as another user" t-on-click="openSwitch">
                        <i class="fa fa-exchange"/>
                    </button>
                    <button class="btn btn-sm btn-light py-0 o_login_as_back" t-on-click="back"
                            t-att-disabled="state.busy">
                        <i class="fa fa-undo me-1"/>Back to <t t-esc="info.origin.name"/>
                    </button>
                </div>
            </t>
            <t t-else="">
                <button class="o_nav_entry btn o_login_as_open" title="Log in as another user"
                        t-on-click="openSwitch">
                    <i class="fa fa-lg fa-user-secret"/>
                </button>
            </t>
        </div>
    </t>
</templates>
