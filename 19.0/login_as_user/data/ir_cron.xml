<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_close_stale_logs" model="ir.cron">
        <field name="name">Login as other user: close expired sessions in the log</field>
        <field name="model_id" ref="model_login_as_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_close_stale()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
