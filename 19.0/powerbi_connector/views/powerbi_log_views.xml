<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_powerbi_log_list" model="ir.ui.view">
        <field name="name">powerbi.log.list</field>
        <field name="model">powerbi.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" decoration-danger="status == 'error'">
                <field name="create_date" string="Date"/>
                <field name="dataset_id"/>
                <field name="table_id"/>
                <field name="operation"/>
                <field name="rows" sum="Rows"/>
                <field name="duration"/>
                <field name="message"/>
                <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'error'"/>
            </list>
        </field>
    </record>

    <record id="view_powerbi_log_search" model="ir.ui.view">
        <field name="name">powerbi.log.search</field>
        <field name="model">powerbi.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="dataset_id"/>
                <field name="message"/>
                <filter name="errors" string="Errors" domain="[('status', '=', 'error')]"/>
            </search>
        </field>
    </record>

    <record id="action_powerbi_log" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">powerbi.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
