<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_names" model="ir.ui.view">
        <field name="name">res.config.settings.form.partner_names</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="users_setting_container" position="after">
                <block title="Contact names" name="partner_names_setting_container">
                    <setting id="partner_names_order_setting" string="Name order"
                             help="How first, middle and last names are put together in the contact name">
                        <field name="partner_names_order" widget="radio"/>
                        <div class="mt-2 text-muted">Preview: <b><field name="partner_names_preview" class="d-inline"/></b></div>
                    </setting>
                    <setting id="partner_names_middle_setting" help="Show a middle name field on contacts and users">
                        <field name="partner_names_middle"/>
                        <div class="mt-3">
                            <button name="action_partner_names_apply" type="object" icon="oi-arrow-right"
                                    string="Apply to all contacts" class="btn-link p-0"
                                    confirm="The name of every person will be rewritten with this order. Continue?"/>
                        </div>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
