<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_cod" model="res.groups.privilege">
        <field name="name">Cash on Delivery</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="sequence">40</field>
    </record>

    <record id="group_cod_driver" model="res.groups">
        <field name="name">Delivery person</field>
        <field name="privilege_id" ref="privilege_cod"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Sees the collections to do and confirms them with the customer's code.</field>
    </record>

    <record id="rule_cod_collection_driver" model="ir.rule">
        <field name="name">COD collection: delivery person</field>
        <field name="model_id" ref="model_sale_cod_collection"/>
        <field name="domain_force">['|', ('driver_id', '=', user.id), ('driver_id', '=', False)]</field>
        <field name="groups" eval="[Command.link(ref('group_cod_driver'))]"/>
    </record>
    <record id="rule_cod_collection_sales" model="ir.rule">
        <field name="name">COD collection: sales</field>
        <field name="model_id" ref="model_sale_cod_collection"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="rule_cod_collection_company" model="ir.rule">
        <field name="name">COD collection: companies</field>
        <field name="model_id" ref="model_sale_cod_collection"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
