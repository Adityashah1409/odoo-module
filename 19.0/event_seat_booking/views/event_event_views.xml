<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="event_event_view_form_seat" model="ir.ui.view">
        <field name="name">event.event.form.seat</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_seats" type="object" class="oe_stat_button" icon="fa-th" invisible="not seat_booking">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="seat_booked" nolabel="1"/> / <field name="seat_total" nolabel="1"/></span>
                        <span class="o_stat_text">Seats</span>
                    </div>
                </button>
                <button name="action_view_waitlist" type="object" class="oe_stat_button" icon="fa-hourglass-half"
                        invisible="not seat_booking">
                    <field name="seat_waitlist_count" widget="statinfo" string="Waitlist"/>
                </button>
            </div>
            <xpath expr="//group[@name='right_event_details']" position="inside">
                <field name="seat_booking" invisible="is_multi_slots"/>
            </xpath>
        </field>
    </record>
    <record id="event_event_view_list_seat" model="ir.ui.view">
        <field name="name">event.event.list.seat</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="seat_occupancy" widget="progressbar" optional="hide" string="Seat occupancy"/>
            </xpath>
        </field>
    </record>
</odoo>
