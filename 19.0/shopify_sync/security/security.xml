<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_shopify" model="res.groups.privilege">
        <field name="name">Shopify</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_shopify_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_shopify"/>
        <field name="implied_ids" eval="[Command.link(ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_shopify_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_shopify"/>
        <field name="implied_ids" eval="[Command.link(ref('group_shopify_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_shopify_instance_company" model="ir.rule">
            <field name="name">Shopify stores: multi-company</field>
            <field name="model_id" ref="model_shopify_instance"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
