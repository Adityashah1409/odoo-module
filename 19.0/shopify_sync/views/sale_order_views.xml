<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_shopify" model="ir.ui.view">
        <field name="name">sale.order.form.shopify</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Shopify" name="shopify" invisible="not shopify_instance_id">
                    <group>
                        <group>
                            <field name="shopify_instance_id"/>
                            <field name="shopify_order_name"/>
                            <field name="shopify_order_id"/>
                        </group>
                        <group>
                            <field name="shopify_financial_status"/>
                            <field name="shopify_fulfillment_status"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_order_list_shopify" model="ir.ui.view">
        <field name="name">sale.order.list.shopify</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="shopify_order_name" optional="show"/>
                <field name="shopify_financial_status" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_sales_order_filter_shopify" model="ir.ui.view">
        <field name="name">sale.order.search.shopify</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <filter name="shopify" string="Shopify orders" domain="[('shopify_instance_id', '!=', False)]"/>
            </xpath>
            <field name="partner_id" position="after">
                <field name="shopify_order_name"/>
            </field>
        </field>
    </record>

    <record id="action_shopify_orders" model="ir.actions.act_window">
        <field name="name">Shopify Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('shopify_instance_id', '!=', False)]</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
