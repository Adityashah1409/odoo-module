<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_activity" model="res.groups.privilege">
        <field name="name">Activity Management</field>
        <field name="sequence">65</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <!-- every internal user manages their own activities; these levels add team-wide and company-wide views -->
    <record id="group_activity_supervisor" model="res.groups">
        <field name="name">Supervisor: own and team activities</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_activity"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_activity_manager" model="res.groups">
        <field name="name">Manager: all activities</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_activity"/>
        <field name="implied_ids" eval="[Command.link(ref('group_activity_supervisor'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>
</odoo>
