<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_activity_view_list_management" model="ir.ui.view">
        <field name="name">mail.activity.list.management</field>
        <field name="model">mail.activity</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <list decoration-danger="progress == 'open' and date_deadline &lt; current_date"
                  decoration-warning="progress == 'open' and date_deadline == current_date"
                  decoration-muted="progress != 'open'" default_order="date_deadline, priority desc" sample="1">
                <header>
                    <button name="action_open_done_wizard" type="object" string="Mark as done"/>
                    <button name="action_open_cancel_wizard" type="object" string="Cancel"/>
                </header>
                <field name="priority" widget="priority" optional="show" nolabel="1"/>
                <field name="date_deadline"/>
                <field name="activity_type_id"/>
                <field name="summary"/>
                <field name="res_name" string="Document"/>
                <field name="res_model_id" optional="hide"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="supervisor_id" widget="many2one_avatar_user" optional="show"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
                <field name="estimated_hours" widget="float_time" optional="hide" sum="Total"/>
                <field name="spent_hours" widget="float_time" optional="hide" sum="Total"/>
                <field name="progress" widget="badge" decoration-info="progress == 'open'"
                       decoration-success="progress == 'done'" decoration-muted="progress == 'cancelled'"/>
                <field name="date_done" optional="hide"/>
                <button name="action_open_document" type="object" icon="fa-external-link" title="Open the document"
                        invisible="not res_model"/>
                <button name="action_open_done_wizard" type="object" icon="fa-check" title="Mark as done"
                        invisible="progress != 'open'"/>
            </list>
        </field>
    </record>

    <record id="mail_activity_view_form_management" model="ir.ui.view">
        <field name="name">mail.activity.form.management</field>
        <field name="model">mail.activity</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_done_wizard" type="object" string="Mark as done" class="oe_highlight"
                            invisible="progress != 'open'"/>
                    <button name="action_timer_start" type="object" string="Start timer" icon="fa-play"
                            invisible="progress != 'open' or timer_start"/>
                    <button name="action_timer_stop" type="object" string="Stop timer" icon="fa-stop"
                            invisible="not timer_start"/>
                    <button name="action_open_cancel_wizard" type="object" string="Cancel activity"
                            invisible="progress != 'open'"/>
                    <button name="action_reopen" type="object" string="Reopen" invisible="progress != 'cancelled'"/>
                    <field name="progress" widget="statusbar" statusbar_visible="open,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_document" type="object" class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not res_model">
                            <div class="o_stat_info"><span class="o_stat_text">Origin</span></div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="progress != 'cancelled'"/>
                    <widget name="web_ribbon" title="Done" bg_color="text-bg-success" invisible="progress != 'done'"/>
                    <div class="oe_title">
                        <field name="priority" widget="priority"/>
                        <h1><field name="summary" placeholder="e.g. Call to discuss the quote"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="activity_type_id" required="1"/>
                            <field name="date_deadline"/>
                            <field name="res_name" string="Document" invisible="not res_model"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="supervisor_id" widget="many2one_avatar_user"/>
                            <field name="done_by_id" invisible="progress != 'done'"/>
                            <field name="date_done" invisible="progress == 'open'"/>
                            <field name="cancelled_by_id" invisible="progress != 'cancelled'"/>
                        </group>
                    </group>
                    <group invisible="progress != 'cancelled'">
                        <field name="cancel_reason"/>
                    </group>
                    <notebook>
                        <page string="Note" name="note">
                            <field name="note" placeholder="Details..."/>
                        </page>
                        <page string="Feedback" name="feedback" invisible="progress == 'open'">
                            <field name="feedback"/>
                        </page>
                        <page string="Time and recurrence" name="time">
                            <group>
                                <group string="Time">
                                    <field name="estimated_hours" widget="float_time"/>
                                    <field name="spent_hours" widget="float_time"/>
                                    <field name="remaining_hours" widget="float_time"/>
                                    <field name="timer_start" invisible="not timer_start"/>
                                </group>
                                <group string="Recurrence">
                                    <label for="recurrence_interval"/>
                                    <div class="o_row">
                                        <field name="recurrence_interval" class="oe_inline"/>
                                        <field name="recurrence_unit" class="oe_inline"/>
                                    </div>
                                    <div colspan="2" class="text-muted small">When marked as done, the next activity is
                                        created automatically (0 = not recurring).</div>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mail_activity_view_kanban_management" model="ir.ui.view">
        <field name="name">mail.activity.kanban.management</field>
        <field name="model">mail.activity</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <kanban default_group_by="activity_type_id" sample="1" quick_create="false">
                <field name="progress"/>
                <field name="date_deadline"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="summary" class="fw-bold"/>
                            <field name="priority" widget="priority"/>
                        </div>
                        <field name="res_name" class="text-muted"/>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        <footer class="pt-1">
                            <field name="date_deadline" widget="remaining_days"/>
                            <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="mail_activity_view_calendar_management" model="ir.ui.view">
        <field name="name">mail.activity.calendar.management</field>
        <field name="model">mail.activity</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <calendar date_start="date_deadline" color="activity_type_id" mode="month" quick_create="0" event_open_popup="1">
                <field name="summary"/>
                <field name="res_name"/>
                <field name="user_id" filters="1" avatar_field="avatar_128"/>
            </calendar>
        </field>
    </record>

    <record id="mail_activity_view_pivot_management" model="ir.ui.view">
        <field name="name">mail.activity.pivot.management</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <pivot sample="1">
                <field name="user_id" type="row"/>
                <field name="progress" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="mail_activity_view_graph_management" model="ir.ui.view">
        <field name="name">mail.activity.graph.management</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="1" sample="1">
                <field name="user_id"/>
                <field name="progress"/>
            </graph>
        </field>
    </record>

    <record id="mail_activity_view_search_management" model="ir.ui.view">
        <field name="name">mail.activity.search.management</field>
        <field name="model">mail.activity</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <search>
                <field name="summary"/>
                <field name="res_name" string="Document"/>
                <field name="activity_type_id"/>
                <field name="user_id"/>
                <field name="supervisor_id"/>
                <field name="tag_ids"/>
                <filter name="open" string="Open" domain="[('progress', '=', 'open')]"/>
                <filter name="overdue" string="Overdue"
                        domain="[('progress', '=', 'open'), ('date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="due_today" string="Today"
                        domain="[('progress', '=', 'open'), ('date_deadline', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="planned" string="Planned"
                        domain="[('progress', '=', 'open'), ('date_deadline', '&gt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="done" string="Done" domain="[('progress', '=', 'done')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('progress', '=', 'cancelled')]"/>
                <separator/>
                <filter name="urgent" string="Important or urgent" domain="[('priority', 'in', ('1', '2'))]"/>
                <filter name="recurring" string="Recurring" domain="[('recurrence_interval', '>', 0)]"/>
                <separator/>
                <filter name="deadline" string="Due date" date="date_deadline"/>
                <group>
                    <filter name="group_type" string="Activity type" context="{'group_by': 'activity_type_id'}"/>
                    <filter name="group_user" string="Assigned to" context="{'group_by': 'user_id'}"/>
                    <filter name="group_supervisor" string="Supervisor" context="{'group_by': 'supervisor_id'}"/>
                    <filter name="group_model" string="Document model" context="{'group_by': 'res_model_id'}"/>
                    <filter name="group_progress" string="Status" context="{'group_by': 'progress'}"/>
                    <filter name="group_deadline" string="Due date" context="{'group_by': 'date_deadline:week'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- actions: my / team / all / history -->
    <record id="action_activity_mine" model="ir.actions.act_window">
        <field name="name">My Activities</field>
        <field name="res_model">mail.activity</field>
        <field name="view_mode">list,kanban,calendar,pivot,graph,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{'search_default_open': 1, 'active_test': False}</field>
        <field name="search_view_id" ref="mail_activity_view_search_management"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No activity assigned to you</p>
            <p>Schedule activities from any document (clock icon in the chatter) or with "Schedule activities".</p>
        </field>
    </record>
    <record id="action_activity_team" model="ir.actions.act_window">
        <field name="name">Team Activities</field>
        <field name="res_model">mail.activity</field>
        <field name="view_mode">list,kanban,calendar,pivot,graph,form</field>
        <field name="domain">['|', '|', ('user_id', '=', uid), ('supervisor_id', '=', uid), ('user_id.activity_supervisor_id', '=', uid)]</field>
        <field name="context">{'search_default_open': 1, 'search_default_group_user': 1, 'active_test': False}</field>
        <field name="search_view_id" ref="mail_activity_view_search_management"/>
    </record>
    <record id="action_activity_all" model="ir.actions.act_window">
        <field name="name">All Activities</field>
        <field name="res_model">mail.activity</field>
        <field name="view_mode">list,kanban,calendar,pivot,graph,form</field>
        <field name="context">{'search_default_open': 1, 'active_test': False}</field>
        <field name="search_view_id" ref="mail_activity_view_search_management"/>
    </record>
    <record id="action_activity_history" model="ir.actions.act_window">
        <field name="name">Activity History</field>
        <field name="res_model">mail.activity</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="domain">[('progress', '!=', 'open')]</field>
        <field name="context">{'active_test': False}</field>
        <field name="search_view_id" ref="mail_activity_view_search_management"/>
    </record>
    <record id="action_activity_dashboard" model="ir.actions.client">
        <field name="name">Activity Dashboard</field>
        <field name="tag">activity_management.dashboard</field>
        <field name="path">activity-dashboard</field>
    </record>
    <record id="action_activity_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'activity_management', 'bin_size': False}</field>
    </record>

    <!-- our views for every activity action of this module -->
    <record id="action_activity_mine_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field><field name="view_mode">list</field>
        <field name="view_id" ref="mail_activity_view_list_management"/><field name="act_window_id" ref="action_activity_mine"/>
    </record>
    <record id="action_activity_mine_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence">2</field><field name="view_mode">kanban</field>
        <field name="view_id" ref="mail_activity_view_kanban_management"/><field name="act_window_id" ref="action_activity_mine"/>
    </record>
    <record id="action_activity_mine_view_calendar" model="ir.actions.act_window.view">
        <field name="sequence">3</field><field name="view_mode">calendar</field>
        <field name="view_id" ref="mail_activity_view_calendar_management"/><field name="act_window_id" ref="action_activity_mine"/>
    </record>
    <record id="action_activity_mine_view_form" model="ir.actions.act_window.view">
        <field name="sequence">6</field><field name="view_mode">form</field>
        <field name="view_id" ref="mail_activity_view_form_management"/><field name="act_window_id" ref="action_activity_mine"/>
    </record>
    <record id="action_activity_team_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field><field name="view_mode">list</field>
        <field name="view_id" ref="mail_activity_view_list_management"/><field name="act_window_id" ref="action_activity_team"/>
    </record>
    <record id="action_activity_team_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence">2</field><field name="view_mode">kanban</field>
        <field name="view_id" ref="mail_activity_view_kanban_management"/><field name="act_window_id" ref="action_activity_team"/>
    </record>
    <record id="action_activity_team_view_calendar" model="ir.actions.act_window.view">
        <field name="sequence">3</field><field name="view_mode">calendar</field>
        <field name="view_id" ref="mail_activity_view_calendar_management"/><field name="act_window_id" ref="action_activity_team"/>
    </record>
    <record id="action_activity_team_view_form" model="ir.actions.act_window.view">
        <field name="sequence">6</field><field name="view_mode">form</field>
        <field name="view_id" ref="mail_activity_view_form_management"/><field name="act_window_id" ref="action_activity_team"/>
    </record>
    <record id="action_activity_all_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field><field name="view_mode">list</field>
        <field name="view_id" ref="mail_activity_view_list_management"/><field name="act_window_id" ref="action_activity_all"/>
    </record>
    <record id="action_activity_all_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence">2</field><field name="view_mode">kanban</field>
        <field name="view_id" ref="mail_activity_view_kanban_management"/><field name="act_window_id" ref="action_activity_all"/>
    </record>
    <record id="action_activity_all_view_calendar" model="ir.actions.act_window.view">
        <field name="sequence">3</field><field name="view_mode">calendar</field>
        <field name="view_id" ref="mail_activity_view_calendar_management"/><field name="act_window_id" ref="action_activity_all"/>
    </record>
    <record id="action_activity_all_view_form" model="ir.actions.act_window.view">
        <field name="sequence">6</field><field name="view_mode">form</field>
        <field name="view_id" ref="mail_activity_view_form_management"/><field name="act_window_id" ref="action_activity_all"/>
    </record>
    <record id="action_activity_history_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field><field name="view_mode">list</field>
        <field name="view_id" ref="mail_activity_view_list_management"/><field name="act_window_id" ref="action_activity_history"/>
    </record>
    <record id="action_activity_history_view_form" model="ir.actions.act_window.view">
        <field name="sequence">6</field><field name="view_mode">form</field>
        <field name="view_id" ref="mail_activity_view_form_management"/><field name="act_window_id" ref="action_activity_history"/>
    </record>
</odoo>
