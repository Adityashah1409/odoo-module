<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_short_url_website" model="ir.rule">
        <field name="name">Short URL: websites of the user's companies</field>
        <field name="model_id" ref="model_short_url"/>
        <field name="domain_force">['|', ('website_id', '=', False), ('website_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
