<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_wh_cost" model="res.groups.privilege">
        <field name="name">Warehouse Costing</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>
    <record id="group_wh_cost_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_wh_cost"/>
        <field name="comment">See warehouse costs and their history, request cost adjustments.</field>
    </record>
    <record id="group_wh_cost_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_wh_cost"/>
        <field name="implied_ids" eval="[(4, ref('group_wh_cost_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Approve cost adjustments, import cost matrices, rebuild warehouse costs.</field>
    </record>
    <record id="stock.group_stock_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_wh_cost_user'))]"/>
    </record>

    <record id="rule_stock_warehouse_cost_company" model="ir.rule">
        <field name="name">Warehouse cost: multi-company</field>
        <field name="model_id" ref="model_stock_warehouse_cost"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_stock_warehouse_cost_line_company" model="ir.rule">
        <field name="name">Warehouse cost history: multi-company</field>
        <field name="model_id" ref="model_stock_warehouse_cost_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_stock_warehouse_cost_adjustment_company" model="ir.rule">
        <field name="name">Warehouse cost adjustment: multi-company</field>
        <field name="model_id" ref="model_stock_warehouse_cost_adjustment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
