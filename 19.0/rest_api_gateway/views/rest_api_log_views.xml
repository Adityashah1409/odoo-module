<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rest_api_log_view_list" model="ir.ui.view">
        <field name="name">rest.api.log.list</field>
        <field name="model">rest.api.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-danger="state == 'server_error'" decoration-warning="state == 'client_error'">
                <field name="create_date" string="Time"/>
                <field name="method"/>
                <field name="path"/>
                <field name="status"/>
                <field name="duration_ms"/>
                <field name="user_id"/>
                <field name="client_id" optional="show"/>
                <field name="ip" optional="show"/>
                <field name="error" optional="hide"/>
                <field name="state" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="rest_api_log_view_form" model="ir.ui.view">
        <field name="name">rest.api.log.form</field>
        <field name="model">rest.api.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="Time"/>
                            <field name="method"/>
                            <field name="path"/>
                            <field name="query"/>
                            <field name="status"/>
                            <field name="duration_ms"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="client_id"/>
                            <field name="endpoint_id"/>
                            <field name="ip"/>
                            <field name="user_agent"/>
                        </group>
                    </group>
                    <group string="Error" invisible="not error">
                        <field name="error" nolabel="1" colspan="2"/>
                    </group>
                    <notebook>
                        <page string="Request body" name="request">
                            <field name="request_body" widget="code" options="{'mode': 'javascript'}"/>
                        </page>
                        <page string="Response body" name="response">
                            <field name="response_body" widget="code" options="{'mode': 'javascript'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rest_api_log_view_search" model="ir.ui.view">
        <field name="name">rest.api.log.search</field>
        <field name="model">rest.api.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="path"/>
                <field name="user_id"/>
                <field name="client_id"/>
                <field name="ip"/>
                <filter name="errors" string="Errors" domain="[('status', '>=', 400)]"/>
                <filter name="server_errors" string="Server errors" domain="[('status', '>=', 500)]"/>
                <filter name="today" string="Today" domain="[('create_date', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_path" string="Path" context="{'group_by': 'path'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="rest_api_log_view_graph" model="ir.ui.view">
        <field name="name">rest.api.log.graph</field>
        <field name="model">rest.api.log</field>
        <field name="arch" type="xml">
            <graph type="line" sample="1">
                <field name="create_date" interval="day"/>
                <field name="state" type="col"/>
            </graph>
        </field>
    </record>

    <record id="action_rest_api_log" model="ir.actions.act_window">
        <field name="name">Request Logs</field>
        <field name="res_model">rest.api.log</field>
        <field name="view_mode">list,graph,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No API request yet</p>
            <p>Every call to /api/v1 is logged here with its status, duration, user and IP address.</p>
        </field>
    </record>
</odoo>
